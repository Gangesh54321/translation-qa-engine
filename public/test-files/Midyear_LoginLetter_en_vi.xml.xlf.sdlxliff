rigin-system="2k UK_UK - VI TM" percent="100"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:00:13</sdl:value><sdl:value key="modified_on">05/05/2026 04:00:16</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1661369406</sdl:value><sdl:value key="SegmentIdentityHash">1Yesrq6bUe9klR3SeuaA9F0SOxxBE9zfORgrAJJ/Wf0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="f66c0ff7-4039-4379-a5fd-04c7cf4a38d2"><source>Your opinion is important in helping to better understand your experience of working at the LEGO Group, supporting the People Promise to ensure everyone can succeed and grow together.</source><seg-source><mrk mtype="seg" mid="7">Your opinion is important in helping to better understand your experience of working at the LEGO Group, supporting the People Promise to ensure everyone can succeed and grow together.</mrk></seg-source><target><mrk mtype="seg" mid="7">Ý kiến của bạn đóng vai trò quan trọng trong việc giúp hiểu rõ hơn trải nghiệm làm việc tại Tập Đoàn LEGO, hỗ trợ Cam Kết Nhân Viên đảm bảo mọi người đều có thể cùng nhau thành công và phát triển.</mrk></target><sdl:seg-defs><sdl:seg id="7" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:00:42</sdl:value><sdl:value key="modified_on">05/05/2026 04:00:42</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">962736236</sdl:value><sdl:value key="SegmentIdentityHash">cP4Q1Swsnkura5y9lhlnaW4sBAVJYnItap4Z7oJCM18=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="2b159e0a-01ff-4698-ac64-1b78645f21af"><source>You are part of the sample for ‘People Pulse snapshot survey’ (drawn randomly by Ennova, our external partner). Thank you for taking part.</source><seg-source><mrk mtype="seg" mid="8">You are part of the sample for ‘People Pulse snapshot survey’ (drawn randomly by Ennova, our external partner).</mrk> <mrk mtype="seg" mid="9">Thank you for taking part.</mrk></seg-source><target><mrk mtype="seg" mid="8">Bạn là một phần của mẫu khảo sát ‘People Pulse snapshot’ (được rút thăm ngẫu nhiên bởi Ennova, đối tác bên ngoài của chúng tôi).</mrk> <mrk mtype="seg" mid="9">Xin cảm ơn sự tham gia của bạn.</mrk></target><sdl:seg-defs><sdl:seg id="8" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:00:44</sdl:value><sdl:value key="modified_on">05/05/2026 04:00:56</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">130751500</sdl:value><sdl:value key="SegmentIdentityHash">UYOTY1l3uAZsmIy+x5QLdT9zqwmCWxs5JRmbQKIS/i4=</sdl:value></sdl:seg><sdl:seg id="9" conf="Translated" origin="interactive" percent="100" text-match="SourceAndTarget"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:prev-origin/><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:01:04</sdl:value><sdl:value key="modified_on">05/05/2026 04:01:04</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-152167682</sdl:value><sdl:value key="SegmentIdentityHash">YClFJDagY1a60viSKQQDABKkgW4u7Bwh8lMCELxqntA=</sdl:value></sdl:prev-origin><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:01:04</sdl:value><sdl:value key="modified_on">05/05/2026 06:00:20</sdl:value><sdl:value key="last_modified_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1948357483</sdl:value><sdl:value key="SegmentIdentityHash">YClFJDagY1a60viSKQQDABKkgW4u7Bwh8lMCELxqntA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="68454c4b-6702-4814-aebb-c350c9975b12"><source>The survey is divided into two sections and should take approximately 10 minutes to complete and the deadline for final submissions is <g id="36">June 11th.</g></source><seg-source><mrk mtype="seg" mid="10">The survey is divided into two sections and should take approximately 10 minutes to complete and the deadline for final submissions is <g id="36">June 11th.</g></mrk></seg-source><target><mrk mtype="seg" mid="10">Khảo sát này được chia thành hai phần và sẽ mất khoảng 10 phút để hoàn thành và thời hạn nộp cuối cùng là <g id="36">ngày 11 tháng 6.</g></mrk></target><sdl:seg-defs><sdl:seg id="10" conf="Translated" origin="interactive" percent="99"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="99"><sdl:prev-origin origin="nmt" origin-system="Machine Translation"><sdl:value key="SegmentIdentityHash">+R0JmUzopgCtaCCsRKFp8cARUVQ3QboUnKPQStV51d4=</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:16:18</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:16:18</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:16:24</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:16:18</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-122604498</sdl:value><sdl:value key="SegmentIdentityHash">Ql10tSdzxetONzaBPLItJNtgdBo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="ed74d07b-1214-4fe1-bc3f-b6d1433b61d2"><source>Completing the questionnaire</source><seg-source><mrk mtype="seg" mid="11">Completing the questionnaire</mrk></seg-source><target><mrk mtype="seg" mid="11">Hoàn thành bảng câu hỏi</mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">cJDShg2oUfSdFgO4w/35CN2VfHbLk2FloBMuutWYKwc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="d21890ec-1cb0-4218-9990-625f723569de"><source>You can fill in the questionnaire from any PC with internet access.</source><seg-source><mrk mtype="seg" mid="12">You can fill in the questionnaire from any PC with internet access.</mrk></seg-source><target><mrk mtype="seg" mid="12">Bạn có thể điền vào bảng câu hỏi từ bất kỳ máy tính nào có truy cập internet.</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">CQ5nL7l1Odf3+4CbrI8J1qfV0AWE8VPjMB8vQXeadRY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="c4304455-810c-42b4-8ceb-02891dc13baf"><source>Your participation is voluntary. Should you find it necessary to take a break before finishing, you can always access the form again to complete it later. Answers already provided will be saved automatically. Once you have completed your response, you will no longer be able to go back and change them.</source><seg-source><mrk mtype="seg" mid="13">Your participation is voluntary. Should you find it necessary to take a break before finishing, you can always access the form again to complete it later. Answers already provided will be saved automatically. Once you have completed your response, you will no longer be able to go back and change them.</mrk></seg-source><target><mrk mtype="seg" mid="13">Việc tham gia của bạn là tự nguyện. Nếu bạn thấy cần nghỉ ngơi trước khi hoàn thành, bạn luôn có thể truy cập lại biểu mẫu này để hoàn thành sau. Câu trả lời của bạn đã cung cấp sẽ được lưu tự động và sẽ được xử lý bảo mật. Một khi bạn đã hoàn thành câu trả lời, bạn sẽ không thể quay trở lại thay đổi các câu trả lời.</mrk></target><sdl:seg-defs><sdl:seg id="13" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="99"><sdl:prev-origin origin="nmt" origin-system="Machine Translation"><sdl:value key="SegmentIdentityHash">3TAxMcJkmmvPKUnf4SLfAeez8tzgHLpZFVYjxK9SAQM=</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:16:29</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:16:26</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1517659540</sdl:value><sdl:value key="SegmentIdentityHash">CVeKuVKiecgWxIlR9+U6U6ye2K8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="c964bb1a-eda8-4967-95d2-58bf44616e23"><source>Website: https://link.ennova.com/LEGOMidyear2026</source><seg-source><mrk mtype="seg" mid="14">Website: https://link.ennova.com/LEGOMidyear2026</mrk></seg-source><target><mrk mtype="seg" mid="14">Trang web: https://link.ennova.com/LEGOMidyear2026</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">5AHeoB+KZIEGSS0H+6+0aK13PfnfELOV01MY+zQR2cQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="ded9a255-b36e-49d3-b552-cfe25802d270"><source>Username: LEGO Employee ID</source><seg-source><mrk mtype="seg" mid="15">Username: LEGO Employee ID</mrk></seg-source><target><mrk mtype="seg" mid="15">Tên người dùng: ID Nhân Viên LEGO</mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">BdYkhnMxFLbDLcAWY6DUvO38LeXMb3ckKTmPSSl17QY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="a7b3b164-0ca6-4a9d-acae-23d40d224645"><source>Password: Year of birth</source><seg-source><mrk mtype="seg" mid="16">Password: Year of birth</mrk></seg-source><target><mrk mtype="seg" mid="16">Mật khẩu: Năm sinh</mrk></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">/MRZRdvQlRVA+O31TF4Rgv2pU/a6HrEwsPi30FdUuUg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="4e7a2f07-419e-447b-a3d4-00f6667570ec"><source>Changes to this year’s Mid-Year People Pulse Survey</source><seg-source><mrk mtype="seg" mid="17">Changes to this year’s Mid-Year People Pulse Survey</mrk></seg-source><target><mrk mtype="seg" mid="17">Những thay đổi đối với khảo sát People Pulse Survey Giữa Năm của năm nay</mrk></target><sdl:seg-defs><sdl:seg id="17" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:02:15</sdl:value><sdl:value key="modified_on">05/05/2026 04:02:23</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-711916119</sdl:value><sdl:value key="SegmentIdentityHash">cTp/YoAaC924+XyGSf1+4pmKg2KD75Ic/Tun/W/WiIA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="1089475f-6891-482a-a493-fb357a4327d6"><source>In this year’s Mid-Year People Pulse survey we have included a set of 10 new engagement questions to build a fuller picture of the colleague experience.</source><seg-source><mrk mtype="seg" mid="18">In this year’s Mid-Year People Pulse survey we have included a set of 10 new engagement questions to build a fuller picture of the colleague experience.</mrk></seg-source><target><mrk mtype="seg" mid="18">Trong khảo sát People Pulse survey Giữa Năm của năm nay, chúng tôi đã đưa vào một bộ 10 câu hỏi mới về sự gắn kết để xây dựng một bức tranh đầy đủ hơn về trải nghiệm của đồng nghiệp.</mrk></target><sdl:seg-defs><sdl:seg id="18" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:03:02</sdl:value><sdl:value key="modified_on">05/05/2026 04:03:02</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2142165147</sdl:value><sdl:value key="SegmentIdentityHash">1MHcPa+EekcKHwACOZkM9Ny4k41iQqzodTGeOhkxnas=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="d4e904a0-4903-4a06-94be-b19dae92c58b"><source>The survey will be divided into two sections. The first section will contain the standard Mid-Year People Pulse questions and be handled in accordance with our established practice with our current provider Ennova.</source><seg-source><mrk mtype="seg" mid="19">The survey will be divided into two sections.</mrk> <mrk mtype="seg" mid="20">The first section will contain the standard Mid-Year People Pulse questions and be handled in accordance with our established practice with our current provider Ennova.</mrk></seg-source><target><mrk mtype="seg" mid="19">Khảo sát này sẽ được chia thành hai phần.</mrk> <mrk mtype="seg" mid="20">Phần đầu tiên sẽ bao gồm các câu hỏi khảo sát People Pulse Giữa Năm tiêu chuẩn và sẽ được xử lý theo thông lệ đã được thiết lập của chúng tôi với nhà cung cấp dịch vụ hiện tại Ennova.</mrk></target><sdl:seg-defs><sdl:seg id="19" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:03:04</sdl:value><sdl:value key="modified_on">05/05/2026 04:03:04</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-760872502</sdl:value><sdl:value key="SegmentIdentityHash">vMJMIT6btcCM/vBJKMa++Gb+o9nTtKeQY0h16v/no6Y=</sdl:value></sdl:seg><sdl:seg id="20" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:03:36</sdl:value><sdl:value key="modified_on">05/05/2026 04:03:41</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">63292140</sdl:value><sdl:value key="SegmentIdentityHash">yJqZQlhGbesZxAMEtnvw2za2Vv/3afMxdhdwjEH//VI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="7bf9104f-e7e8-4da7-8605-4d39ba6f89a9"><source>The second section will contain the 10 new engagement questions. Your individual identifiable responses will be available to the LEGO Group, who will share these responses with Qualtrics. The LEGO Group is piloting Qualtrics as a potential new survey technology provider.</source><seg-source><mrk mtype="seg" mid="21">The second section will contain the 10 new engagement questions.</mrk> <mrk mtype="seg" mid="22">Your individual identifiable responses will be available to the LEGO Group, who will share these responses with Qualtrics.</mrk> <mrk mtype="seg" mid="23">The LEGO Group is piloting Qualtrics as a potential new survey technology provider.</mrk></seg-source><target><mrk mtype="seg" mid="21">Phần thứ hai sẽ bao gồm 10 câu hỏi mới về sự gắn kết.</mrk> <mrk mtype="seg" mid="22">Các câu trả lời có thể nhận dạng cá nhân của bạn sẽ được cung cấp cho Tập Đoàn LEGO, họ sẽ chia sẻ những câu trả lời này với Qualtrics.</mrk> <mrk mtype="seg" mid="23">Tập Đoàn LEGO đang thí điểm thuê Qualtrics như một nhà cung cấp công nghệ khảo sát mới tiềm năng.</mrk></target><sdl:seg-defs><sdl:seg id="21" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:03:47</sdl:value><sdl:value key="modified_on">05/05/2026 04:03:47</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-913270770</sdl:value><sdl:value key="SegmentIdentityHash">g8UY6ND2qV57cdsU4zCysNX4qAe8sPLYXzoCZr/6Rsg=</sdl:value></sdl:seg><sdl:seg id="22" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:04:05</sdl:value><sdl:value key="modified_on">05/05/2026 04:04:05</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">799006613</sdl:value><sdl:value key="SegmentIdentityHash">GYJOZzUv5Fv0DAuoEMAlxQ3/iK5gl8QE1cOodOSSUmo=</sdl:value></sdl:seg><sdl:seg id="23" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:04:28</sdl:value><sdl:value key="modified_on">05/05/2026 04:04:28</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1539979987</sdl:value><sdl:value key="SegmentIdentityHash">yQXQpBSWSis/Sl8zl+sQ5ygR1IwO8mG1WcprHUU70+A=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="91704e31-d251-4ab1-a2aa-f26270d3ae55"><source>This means a limited number of colleagues in the People Insights &amp; Analytics team will have access to the individual identifiable responses for analytical purposes. The LEGO Group will use Qualtrics’ platform to build a new dashboard to analyse and assess responses and trends.</source><seg-source><mrk mtype="seg" mid="24">This means a limited number of colleagues in the People Insights &amp; Analytics team will have access to the individual identifiable responses for analytical purposes.</mrk> <mrk mtype="seg" mid="25">The LEGO Group will use Qualtrics’ platform to build a new dashboard to analyse and assess responses and trends.</mrk></seg-source><target><mrk mtype="seg" mid="24">Điều này có nghĩa là một số lượng hạn chế đồng nghiệp trong đội ngũ People Insights &amp; Analytics (Phân Tích Nhân Sự) sẽ có quyền tiếp cận các câu trả lời có thể nhận dạng cá nhân cho mục đích phân tích.</mrk> <mrk mtype="seg" mid="25">Tập Đoàn LEGO sẽ sử dụng nền tảng của Qualtrics để xây dựng một bảng chỉ số mới nhằm phân tích và đánh giá các câu trả lời và xu hướng.</mrk></target><sdl:seg-defs><sdl:seg id="24" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:04:52</sdl:value><sdl:value key="modified_on">05/05/2026 04:05:59</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">511147178</sdl:value><sdl:value key="SegmentIdentityHash">i1DppeztB48UyaBcrNfywv5nLC7VS7AEf7JZBc9+4jg=</sdl:value></sdl:seg><sdl:seg id="25" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:05:16</sdl:value><sdl:value key="modified_on">05/05/2026 04:05:16</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">799501612</sdl:value><sdl:value key="SegmentIdentityHash">pEKLObWypFgI9SSsvdEde5z2TGjhDynwo500q3Dyl/M=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="07930186-1462-4269-941f-788abf365376"><source>Individual identifiable responses will not be shared with People Leaders, People Partners, functional leaders or anyone outside the People Insights &amp; Analytics team. All responses will be handled confidentially and are subject to appropriate technical and organisational measures to protect personal data.</source><seg-source><mrk mtype="seg" mid="26">Individual identifiable responses will not be shared with People Leaders, People Partners, functional leaders or anyone outside the People Insights &amp; Analytics team.</mrk> <mrk mtype="seg" mid="27">All responses will be handled confidentially and are subject to appropriate technical and organisational measures to protect personal data.</mrk></seg-source><target><mrk mtype="seg" mid="26">Các câu trả lời có thể nhận dạng cá nhân sẽ không được chia sẻ với các Nhà Lãnh Đạo Nhân Sự, Đối Tác Nhân Sự, lãnh đạo bộ phận hoặc bất kỳ ai bên ngoài đội ngũ People Insights &amp; Analytics.</mrk> <mrk mtype="seg" mid="27">Tất cả các câu trả lời sẽ được xử lý bảo mật và tuân theo các biện pháp kỹ thuật và tổ chức thích hợp để bảo vệ dữ liệu cá nhân.</mrk></target><sdl:seg-defs><sdl:seg id="26" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:06:01</sdl:value><sdl:value key="modified_on">05/05/2026 04:06:01</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">34464180</sdl:value><sdl:value key="SegmentIdentityHash">du9cUMMDMjrXwCmCVb9PxVCix67y/HSr2yt2pmFOL3U=</sdl:value></sdl:seg><sdl:seg id="27" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:06:13</sdl:value><sdl:value key="modified_on">05/05/2026 04:06:13</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1619647508</sdl:value><sdl:value key="SegmentIdentityHash">3mkP5dZdtfhpiM7bom3fFwuypsTDfg03YhBuPAlzvFE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="b3a4806d-53d3-46e6-985f-43394b425077"><source>You can read more about it in “processing personal data.”</source><seg-source><mrk mtype="seg" mid="28">You can read more about it in “processing personal data.”</mrk></seg-source><target><mrk mtype="seg" mid="28">Bạn có thể đọc thêm về việc này trong phần &quot;xử lý dữ liệu cá nhân.&quot;</mrk></target><sdl:seg-defs><sdl:seg id="28" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:06:23</sdl:value><sdl:value key="modified_on">05/05/2026 04:06:23</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-654538620</sdl:value><sdl:value key="SegmentIdentityHash">bUOi6F4B9VNW5TXUYX9GNr/Iy1TZnREdiXG4k5GIH+8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="b4a51d61-fbce-468d-82be-3eb7e71f48c0"><source>If you have any questions or problems</source><seg-source><mrk mtype="seg" mid="29">If you have any questions or problems</mrk></seg-source><target><mrk mtype="seg" mid="29">Nếu bạn có bất cứ thắc mắc hoặc vấn đề nào</mrk></target><sdl:seg-defs><sdl:seg id="29" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">VfANmRn6e1h27vNylDb50MJ1XCu1qNPrLjornle2dCc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="98e17b33-cb7a-4a7e-abd5-da5ed973e1f3"><source>If you have questions regarding the survey, please contact BSO Service Desk via lego.service-now.com. If you experience problems with the questionnaire, you are welcome to contact Ennova by e-mail LEGOGroup@ennova.com.</source><seg-source><mrk mtype="seg" mid="30">If you have questions regarding the survey, please contact BSO Service Desk via lego.service-now.com. If you experience problems with the questionnaire, you are welcome to contact Ennova by e-mail LEGOGroup@ennova.com.</mrk></seg-source><target><mrk mtype="seg" mid="30">Nếu bạn có các thắc mắc liên quan đến khảo sát, vui lòng liên hệ với Bộ Phận Dịch Vụ BSO qua lego.service-now.com. Nếu bạn gặp vấn đề với bảng câu hỏi, bạn có thể liên hệ với Ennova qua email LEGOGroup@ennova.com.</mrk></target><sdl:seg-defs><sdl:seg id="30" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">haUnvR1nhtDJlzSApg2iMeibWdFAUU2AQHPTr8/iXxs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="bb312141-4a21-4684-a089-de6a4805b65e"><source>We hope that you will take this opportunity to complete the survey. On behalf of the LEGO Group, we thank you for sharing your views.</source><seg-source><mrk mtype="seg" mid="31">We hope that you will take this opportunity to complete the survey. On behalf of the LEGO Group, we thank you for sharing your views.</mrk></seg-source><target><mrk mtype="seg" mid="31">Chúng tôi hy vọng bạn sẽ tận dụng cơ hội này để hoàn thành khảo sát. Thay mặt cho Tập Đoàn LEGO, chúng tôi xin cảm ơn bạn đã chia sẻ quan điểm của mình.</mrk></target><sdl:seg-defs><sdl:seg id="31" conf="Translated" origin="interactive" percent="100"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="100"><sdl:prev-origin/><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:06:39</sdl:value><sdl:value key="modified_on">05/05/2026 04:06:39</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1319379934</sdl:value><sdl:value key="SegmentIdentityHash">x6jNFSJBYALs1I/vtG4+koJNZYHB4x0OpgTLfNCbhzw=</sdl:value></sdl:prev-origin><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:06:39</sdl:value><sdl:value key="modified_on">05/05/2026 06:18:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1960008423</sdl:value><sdl:value key="SegmentIdentityHash">x6jNFSJBYALs1I/vtG4+koJNZYHB4x0OpgTLfNCbhzw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="b062f3e0-27fe-4ce1-876a-62fd3aebd8d1"><source>Kind regards,</source><seg-source><mrk mtype="seg" mid="32">Kind regards,</mrk></seg-source><target><mrk mtype="seg" mid="32">Xin chân thành cảm ơn!</mrk></target><sdl:seg-defs><sdl:seg id="32" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">iMYoRnloAYavX5s3I/mYEoBAz+DPd/FoKUnYZ6I3CGA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="9bd5be3c-d4fe-46b4-a37b-02a56f480359"><source>Ennova</source><seg-source><mrk mtype="seg" mid="33">Ennova</mrk></seg-source><target><mrk mtype="seg" mid="33">Ennova</mrk></target><sdl:seg-defs><sdl:seg id="33" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">yV4Ka1uK3RFteZeeqLcv9JrKvuIE9c/FqECf7m5YxWQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="5449b0ae-c28a-4379-89d9-bd85480174db"><source>Processing personal data and your confidentiality</source><seg-source><mrk mtype="seg" mid="34">Processing personal data and your confidentiality</mrk></seg-source><target><mrk mtype="seg" mid="34">Xử lý dữ liệu cá nhân và bảo mật của bạn</mrk></target><sdl:seg-defs><sdl:seg id="34" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">5hObhm7nzLf69yAbUE1J+25q8KIxX13yBxIQP3gMrl8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="b94af072-0905-44c6-99f4-9534d73160dd"><source>Mid-Year People Pulse is carried out by our external survey provider (acting as a data processor) on behalf of your employer, the LEGO Group (acting as the data controller).</source><seg-source><mrk mtype="seg" mid="35">Mid-Year People Pulse is carried out by our external survey provider (acting as a data processor) on behalf of your employer, the LEGO Group (acting as the data controller).</mrk></seg-source><target><mrk mtype="seg" mid="35">Khảo sát People Pulse Giữa Năm được thực hiện bởi nhà cung cấp dịch vụ khảo sát bên ngoài của chúng tôi (đóng vai trò là đơn vị xử lý dữ liệu) thay mặt cho nhà tuyển dụng của bạn, Tập Đoàn LEGO (đóng vai trò là đơn vị kiểm soát dữ liệu).</mrk></target><sdl:seg-defs><sdl:seg id="35" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:07:18</sdl:value><sdl:value key="modified_on">05/05/2026 04:07:18</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1848539642</sdl:value><sdl:value key="SegmentIdentityHash">wQHg0wfoSefUgbX2kl4cSldjai0yfBdRWMLeaPaUD/A=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="3c9be155-8ae0-4586-893b-7bd701282d0e"><source>The LEGO Group has a legitimate interest in processing and collecting your personal data in Mid-Year People Pulse to understand and measure levels of satisfaction, motivation and opinions of employees.</source><seg-source><mrk mtype="seg" mid="36">The LEGO Group has a legitimate interest in processing and collecting your personal data in Mid-Year People Pulse to understand and measure levels of satisfaction, motivation and opinions of employees.</mrk></seg-source><target><mrk mtype="seg" mid="36">Tập Đoàn LEGO có lợi ích chính đáng trong việc xử lý và thu thập dữ liệu cá nhân của bạn trong khảo sát People Pulse Giữa Năm để hiểu và đánh giá mức độ hài lòng, động lực và ý kiến của nhân viên.</mrk></target><sdl:seg-defs><sdl:seg id="36" conf="Translated" origin="interactive" percent="100" text-match="SourceAndTarget"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:prev-origin/><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:08:31</sdl:value><sdl:value key="modified_on">05/05/2026 04:08:31</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1365043818</sdl:value><sdl:value key="SegmentIdentityHash">fh0e+sGZ7U2JXe27mWE8Ha/ErOtxVcClPYW2lqIVwhs=</sdl:value></sdl:prev-origin><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:08:31</sdl:value><sdl:value key="modified_on">05/05/2026 06:18:53</sdl:value><sdl:value key="last_modified_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2079530598</sdl:value><sdl:value key="SegmentIdentityHash">fh0e+sGZ7U2JXe27mWE8Ha/ErOtxVcClPYW2lqIVwhs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="31b4977b-1e31-4917-9ca0-4df09cc69525"><source>To administer the Mid-Year People Pulse and enable aggregated analysis, the LEGO Group will process certain personal data relating to you. This will include selected employment related data, such as LEGO e-mail address, ELT area, department name, team name, work location, seniority with the LEGO Group, salaried/non-salaried status, company code, job level or similar information but also full name, age and gender.</source><seg-source><mrk mtype="seg" mid="37">To administer the Mid-Year People Pulse and enable aggregated analysis, the LEGO Group will process certain personal data relating to you.</mrk> <mrk mtype="seg" mid="38">This will include selected employment related data, such as LEGO e-mail address, ELT area, department name, team name, work location, seniority with the LEGO Group, salaried/non-salaried status, company code, job level or similar information but also full name, age and gender.</mrk></seg-source><target><mrk mtype="seg" mid="37">Để quản lý khảo sát People Pulse Giữa Năm và tạo điều kiện phân tích tổng hợp, Tập Đoàn LEGO sẽ xử lý dữ liệu cá nhân nhất định liên quan đến bạn.</mrk> <mrk mtype="seg" mid="38">Thông tin này sẽ bao gồm dữ liệu chọn lọc liên quan đến công việc, chẳng hạn như địa chỉ email LEGO, khu vực ELT, tên phòng ban, tên đội ngũ, địa điểm làm việc, thâm niên với Tập Đoàn LEGO, tình trạng hưởng lương/không lương, mã công ty, cấp công việc hoặc thông tin tương tự nhưng cũng bao gồm họ tên, tuổi và giới tính.</mrk></target><sdl:seg-defs><sdl:seg id="37" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:08:56</sdl:value><sdl:value key="modified_on">05/05/2026 04:08:56</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-972712931</sdl:value><sdl:value key="SegmentIdentityHash">6KskV1IKVPa+Ms9HzuHm8oihnCxQTuepn6AuoqdWmxU=</sdl:value></sdl:seg><sdl:seg id="38" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:10:01</sdl:value><sdl:value key="modified_on">05/05/2026 04:10:01</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1395736333</sdl:value><sdl:value key="SegmentIdentityHash">+GMh9e/EtExh8ocAcXbuKip5+UPNc37fK932dUzNr0w=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="1dda8d3e-359a-4543-a748-a500c1985479"><source>It is also important to inform you that only the necessary personal data will be processed for Mid-Year People Pulse to achieve the above-mentioned purposes.</source><seg-source><mrk mtype="seg" mid="39">It is also important to inform you that only the necessary personal data will be processed for Mid-Year People Pulse to achieve the above-mentioned purposes.</mrk></seg-source><target><mrk mtype="seg" mid="39">Cũng cần thông tin cho bạn rằng chỉ có dữ liệu cá nhân cần thiết mới được xử lý cho khảo sát People Pulse Giữa Năm để đạt được các mục đích đã đề cập bên trên.</mrk></target><sdl:seg-defs><sdl:seg id="39" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:11:11</sdl:value><sdl:value key="modified_on">05/05/2026 04:11:11</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1363536537</sdl:value><sdl:value key="SegmentIdentityHash">aPChcBU1/2rm0jkRtsQg0lXM6Mn7hRQLLPDsnvjKSQ0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="45022834-d618-48b0-98bd-a26f9c5a630e"><source>By proceeding, you start the questionnaire where the LEGO Group will process your personal data in connection with Mid-Year People Pulse snapshot survey. For employees within the EU the legal basis is legitimate interest cf. GDPR, art. 6, 1(f).</source><seg-source><mrk mtype="seg" mid="40">By proceeding, you start the questionnaire where the LEGO Group will process your personal data in connection with Mid-Year People Pulse snapshot survey.</mrk> <mrk mtype="seg" mid="41">For employees within the EU the legal basis is legitimate interest cf. GDPR, art.</mrk> <mrk mtype="seg" mid="42">6, 1(f).</mrk></seg-source><target><mrk mtype="seg" mid="40">Bằng việc tiếp tục, bạn sẽ bắt đầu trả lời bảng câu hỏi, trong đó Tập Đoàn LEGO sẽ xử lý dữ liệu cá nhân của bạn liên quan đến khảo sát People Pulse snapshot Giữa Năm.</mrk> <mrk mtype="seg" mid="41">Đối với người lao động trong EU, cơ sở pháp lý là lợi ích hợp pháp theo GDPR, Điều 6, khoản 1(f).</mrk> <mrk mtype="seg" mid="42">6, 1(f).</mrk></target><sdl:seg-defs><sdl:seg id="40" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:11:15</sdl:value><sdl:value key="modified_on">05/05/2026 04:11:28</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">757049081</sdl:value><sdl:value key="SegmentIdentityHash">7t3ySFfRQgINz2CJdGffzwNs3s2Ukf3pakvmHxgGlWg=</sdl:value></sdl:seg><sdl:seg id="41" conf="Translated"><sdl:value key="SegmentIdentityHash">RSd/JdAdBhUi5nhvH9gCbCiZggirCkSvCxsvprjwjwg=</sdl:value></sdl:seg><sdl:seg id="42" conf="Translated"><sdl:value key="SegmentIdentityHash">W8J84VkVRuog2H63KNPTop0+kKoNamzbzTgvjik8A90=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="2cb76583-e042-4d1c-a0d9-5807ff1cebd8"><source>You can read more about the LEGO Group&apos;s processing of your personal data here:</source><seg-source><mrk mtype="seg" mid="43">You can read more about the LEGO Group&apos;s processing of your personal data here:</mrk></seg-source><target><mrk mtype="seg" mid="43">Bạn có thể tìm hiểu thêm về cách Tập đoàn LEGO xử lý dữ liệu cá nhân của bạn tại đây:</mrk></target><sdl:seg-defs><sdl:seg id="43" conf="Translated"><sdl:value key="SegmentIdentityHash">clGugjHUCxuyphBDvMBwubo8Emwi7iGT1+JaQO4sbIw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="d64432f3-669c-4547-98e0-1afffdb239d1"><source><g id="37">https://legogroup.sharepoint.com/:w:/r/sites/PolicyPortal/_layouts/15/Doc.aspx?sourcedoc=%7BFEF63DFA-6BA2-4808-B769-C46A264513DD%7D&amp;file=Global%20Employee%20Privacy%20Policy.docx&amp;action=default&amp;mobileredirect=true</g></source><seg-source><mrk mtype="seg" mid="44"><g id="37">https://legogroup.sharepoint.com/:w:/r/sites/PolicyPortal/_layouts/15/Doc.aspx?sourcedoc=%7BFEF63DFA-6BA2-4808-B769-C46A264513DD%7D&amp;file=Global%20Employee%20Privacy%20Policy.docx&amp;action=default&amp;mobileredirect=true</g></mrk></seg-source><target><mrk mtype="seg" mid="44"><g id="37">https://legogroup.sharepoint.com/:w:/r/sites/PolicyPortal/_layouts/15/Doc.aspx?sourcedoc=%7BFEF63DFA-6BA2-4808-B769-C46A264513DD%7D&amp;file=Global%20Employee%20Privacy%20Policy.docx&amp;action=default&amp;mobileredirect=true</g></mrk></target><sdl:seg-defs><sdl:seg id="44" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">PlDiqfRWIff0gTvxFTemuaOyjRAzv33k3taMO8XnVzQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="a71f6521-12d7-4f7e-915f-6b605f61c75f"><source>Results from first section of the survey are only made available with a minimum of five responses. If you are in a team with less than five respondents, your answers will be included in a joint result.</source><seg-source><mrk mtype="seg" mid="45">Results from first section of the survey are only made available with a minimum of five responses.</mrk> <mrk mtype="seg" mid="46">If you are in a team with less than five respondents, your answers will be included in a joint result.</mrk></seg-source><target><mrk mtype="seg" mid="45">Kết quả từ phần đầu tiên của khảo sát chỉ được cung cấp với tối thiểu 5 câu trả lời.</mrk> <mrk mtype="seg" mid="46">Nếu nhóm của bạn có ít hơn năm người trả lời khảo sát, câu trả lời của bạn sẽ được gộp chung vào một kết quả tổng hợp.</mrk></target><sdl:seg-defs><sdl:seg id="45" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:13:13</sdl:value><sdl:value key="modified_on">05/05/2026 04:13:13</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1495315497</sdl:value><sdl:value key="SegmentIdentityHash">AgNEACgIOe29V/t+SF8mI92XGDk7avo5nCOaozZXSiU=</sdl:value></sdl:seg><sdl:seg id="46" conf="Translated"><sdl:rep id="KyGyegY62wF73WHAUraWnJ9uL5arWs1V6xqMpoivnZQ="/><sdl:value key="SegmentIdentityHash">KyGyegY62wF73WHAUraWnJ9uL5arWs1V6xqMpoivnZQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="227b7b5d-4287-41e3-ad9c-2c1bc2d3e369"><source>Your individual identifiable responses to second section of the survey will be available to the LEGO Group, however access is strictly limited to a small number of employees within the People Insights &amp; Analytics team (a team of no more than 5 employees) in the LEGO Group who need this access for analysis purposes. Your individual identifiable responses will not be shared with People Leaders, People Partners, functional leaders or anyone else apart from the People Insights &amp; Analytics team. Your People Leaders, People Partners, functional leaders will only receive aggregated results with a minimum of five responses. If you are in a team with less than five respondents, your answers will be included in a joint result.</source><seg-source><mrk mtype="seg" mid="47">Your individual identifiable responses to second section of the survey will be available to the LEGO Group, however access is strictly limited to a small number of employees within the People Insights &amp; Analytics team (a team of no more than 5 employees) in the LEGO Group who need this access for analysis purposes.</mrk> <mrk mtype="seg" mid="48">Your individual identifiable responses will not be shared with People Leaders, People Partners, functional leaders or anyone else apart from the People Insights &amp; Analytics team.</mrk> <mrk mtype="seg" mid="49">Your People Leaders, People Partners, functional leaders will only receive aggregated results with a minimum of five responses.</mrk> <mrk mtype="seg" mid="50">If you are in a team with less than five respondents, your answers will be included in a joint result.</mrk></seg-source><target><mrk mtype="seg" mid="47">Các câu trả lời có thể nhận dạng cá nhân của bạn cho phần thứ hai của khảo sát sẽ được cung cấp cho Tập Đoàn LEGO, tuy nhiên quyền tiếp cận chỉ giới hạn ở một số ít nhân viên trong đội ngũ People Insights &amp; Analytics (một nhóm không quá 5 nhân viên) trong Tập Đoàn LEGO, họ cần quyền tiếp cận này cho mục đích phân tích.</mrk> <mrk mtype="seg" mid="48">Các câu trả lời có thể nhận dạng cá nhân của bạn sẽ không được chia sẻ với các Nhà Lãnh Đạo Nhân Sự, Đối Tác Nhân Sự, lãnh đạo bộ phận hoặc bất kỳ ai bên ngoài đội ngũ People Insights &amp; Analytics.</mrk> <mrk mtype="seg" mid="49">Các Nhà Lãnh Đạo Nhân Sự, Đối Tác Nhân Sự, các lãnh đạo bộ phận sẽ chỉ nhận được kết quả tổng hợp với tối thiểu 5 câu trả lời.</mrk> <mrk mtype="seg" mid="50">Nếu nhóm của bạn có ít hơn năm người trả lời khảo sát, câu trả lời của bạn sẽ được gộp chung vào một kết quả tổng hợp.</mrk></target><sdl:seg-defs><sdl:seg id="47" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="Source"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:01</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:01</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">290956172</sdl:value><sdl:value key="SegmentIdentityHash">Mp0E59yAIM4ySv0r05VuKuZp3d2krHo7YLTC2Rd45Mg=</sdl:value></sdl:seg><sdl:seg id="48" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:06</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:12</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-790938561</sdl:value><sdl:value key="SegmentIdentityHash">JCRipt7az4J+Yni59N3z1uaHE4WpF0LDZV7RHREgvzs=</sdl:value></sdl:seg><sdl:seg id="49" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:32</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:33</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1300353419</sdl:value><sdl:value key="SegmentIdentityHash">1pq5W3FzmUQWBgkhPvgTpO4o9gWb8sleFQR2YsmMFdM=</sdl:value></sdl:seg><sdl:seg id="50" conf="Translated"><sdl:rep id="KyGyegY62wF73WHAUraWnJ9uL5arWs1V6xqMpoivnZQ="/><sdl:value key="SegmentIdentityHash">KyGyegY62wF73WHAUraWnJ9uL5arWs1V6xqMpoivnZQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="0ab55994-d7b1-4d94-ac50-274912e30715"><source>All responses are handled confidentially by the LEGO Group and are subject to appropriate technical and organisational measures to protect your personal data. Your individual responses will be transferred to Qualtrics for analytics as described above.</source><seg-source><mrk mtype="seg" mid="51">All responses are handled confidentially by the LEGO Group and are subject to appropriate technical and organisational measures to protect your personal data.</mrk> <mrk mtype="seg" mid="52">Your individual responses will be transferred to Qualtrics for analytics as described above.</mrk></seg-source><target><mrk mtype="seg" mid="51">Tất cả các câu trả lời được xử lý bảo mật bởi Tập Đoàn LEGO và phải tuân theo các biện pháp kỹ thuật và tổ chức thích hợp để bảo vệ dữ liệu cá nhân của bạn.</mrk> <mrk mtype="seg" mid="52">Các câu trả lời cá nhân của bạn sẽ được chuyển cho Qualtrics để phân tích như mô tả bên trên.</mrk></target><sdl:seg-defs><sdl:seg id="51" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="Source"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:45</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:46</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1878819933</sdl:value><sdl:value key="SegmentIdentityHash">Vf6ygW7SCixg9rW1nKryQ5TRoz3Oi4i7lUyQAoEeH4E=</sdl:value></sdl:seg><sdl:seg id="52" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:54</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:54</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2127712215</sdl:value><sdl:value key="SegmentIdentityHash">NiitDaLDJqcutWl7P6dmOfhjyiSJPRCs8CW8Hk7w1WE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="b2263684-b6bd-4fe0-aa48-6128350d8ae9"><source>If you want access to your data, want to have your data deleted or want to exercise another Privacy Right in the GDPR, you need to use the link above to make sure that your request will be well received and handled by the LEGO Group.</source><seg-source><mrk mtype="seg" mid="53">If you want access to your data, want to have your data deleted or want to exercise another Privacy Right in the GDPR, you need to use the link above to make sure that your request will be well received and handled by the LEGO Group.</mrk></seg-source><target><mrk mtype="seg" mid="53">Nếu bạn muốn truy cập dữ liệu của mình, muốn xóa dữ liệu hoặc muốn thực hiện một quyền riêng tư khác theo GDPR, bạn cần sử dụng liên kết ở trên để đảm bảo yêu cầu của bạn được Tập đoàn LEGO tiếp nhận và xử lý đầy đủ.</mrk></target><sdl:seg-defs><sdl:seg id="53" conf="Translated"><sdl:value key="SegmentIdentityHash">I3UoD6Fjs9Cy8Zgno+i3ACE+GPvRPK7FlQUWGD0ssV4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="ce1d4453-c19f-4366-a40c-f4a236354d3b"><source>If you may have questions about how the LEGO Group is handling your personal data, you can ask the Data Protection Officer (DPO) - gdpr.hr@LEGO.com.</source><seg-source><mrk mtype="seg" mid="54">If you may have questions about how the LEGO Group is handling your personal data, you can ask the Data Protection Officer (DPO) - gdpr.hr@LEGO.com.</mrk></seg-source><target><mrk mtype="seg" mid="54">Nếu bạn có thể có thắc mắc về cách thức Tập Đoàn LEGO xử lý dữ liệu cá nhân của bạn, bạn có thể hỏi Cán Bộ Bảo Vệ Dữ Liệu (DPO) của Tập Đoàn LEGO - gdpr.hr@LEGO.com.</mrk></target><sdl:seg-defs><sdl:seg id="54" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="Source"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:15:14</sdl:value><sdl:value key="modified_on">05/05/2026 04:15:15</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-41229032</sdl:value><sdl:value key="SegmentIdentityHash">sdTh9HGDx7HUHmGCzVZ5Y3tMmldXV8QA62jG6jsJLjE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="84de5484-5831-49f2-8da5-3ade6843a9a3"><source><x id="39"/> <x id="40"/> <x id="41"/> <x id="42"/> <x id="43"/> <x id="44"/> &lt;!--[if (gte mso 9)|(IE)]&gt; <x id="45"/> <x id="46"/> <x id="47"/> &lt;![endif]--&gt; <x id="48"/> <x id="49"/> <x id="50"/> <x id="51"/> <x id="52"/> <x id="53"/></source><seg-source><mrk mtype="seg" mid="55"><x id="39"/> <x id="40"/> <x id="41"/> <x id="42"/> <x id="43"/> <x id="44"/> &lt;!--[if (gte mso 9)|(IE)]&gt; <x id="45"/> <x id="46"/> <x id="47"/> &lt;![endif]--&gt; <x id="48"/> <x id="49"/> <x id="50"/> <x id="51"/> <x id="52"/> <x id="53"/></mrk></seg-source><target><mrk mtype="seg" mid="55"><x id="39"/> <x id="40"/> <x id="41"/> <x id="39"/> <x id="40"/> <x id="41"/> &lt;!--[if (gte mso 9)|(IE)]&gt; <x id="39"/> <x id="40"/> <x id="41"/> &lt;![endif]--&gt; <x id="48"/> <x id="49"/> <x id="39"/> <x id="40"/> <x id="41"/> <x id="48"/></mrk></target><sdl:seg-defs><sdl:seg id