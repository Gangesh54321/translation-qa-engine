/sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:18:41</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:18:39</sdl:value><sdl:value key="FuzzyMatchRepair">true</sdl:value><sdl:value key="SDL:ProjectTranslationHash">360012201</sdl:value><sdl:value key="SegmentIdentityHash">0ldmDGilkMD3T+7Cj7xkxMBGOXI=</sdl:value></sdl:seg><sdl:seg id="5" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:18:50</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:18:50</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1885013894</sdl:value><sdl:value key="SegmentIdentityHash">xUIFMevhk+vnaZbAjxtHloGHhk8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="e3441ac0-1cb0-4642-9b77-58c21c22acb8"><source>The questionnaire takes approximately 10 minutes to complete and the deadline is <g id="32">June 11th</g>.</source><seg-source><mrk mtype="seg" mid="6">The questionnaire takes approximately 10 minutes to complete and the deadline is <g id="32">June 11th</g>.</mrk></seg-source><target><mrk mtype="seg" mid="6">Bảng câu hỏi này mất khoảng 10 phút để hoàn thành và thời hạn là <g id="32">ngày 11 tháng 6</g>.</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">E7vMuzem6qc88/EKaeiqWQfDUk0wFLN0XH+vRS911Wg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="a42dba3c-cacc-4e61-907e-2e5b241877d1"><source>If you have already answered the questionnaire, please ensure you click “OK” at the end to register as complete.</source><seg-source><mrk mtype="seg" mid="7">If you have already answered the questionnaire, please ensure you click “OK” at the end to register as complete.</mrk></seg-source><target><mrk mtype="seg" mid="7">Nếu bạn đã trả lời bảng câu hỏi, vui lòng đảm bảo rằng bạn nhấp vào &quot;OK&quot; ở cuối để đăng ký là hoàn tất.</mrk></target><sdl:seg-defs><sdl:seg id="7" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:19:00</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:18:59</sdl:value><sdl:value key="SDL:ProjectTranslationHash">350251113</sdl:value><sdl:value key="SegmentIdentityHash">qZ9HBf6njI6+bJgnuxIt5QZ+0mo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="a560df70-4e1c-4bbd-a751-bb9f7ef5c33d"><source>Completing the questionnaire</source><seg-source><mrk mtype="seg" mid="8">Completing the questionnaire</mrk></seg-source><target><mrk mtype="seg" mid="8">Hoàn thành bảng câu hỏi</mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">cJDShg2oUfSdFgO4w/35CN2VfHbLk2FloBMuutWYKwc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="b0f1cc16-8831-4aa1-9b6e-044cea39ce5e"><source>You can access the questionnaire by clicking the button below. This e-mail is personal and may not be shared with others.</source><seg-source><mrk mtype="seg" mid="9">You can access the questionnaire by clicking the button below. This e-mail is personal and may not be shared with others.</mrk></seg-source><target><mrk mtype="seg" mid="9">Bạn có thể truy cập bảng câu hỏi bằng cách nhấp vào nút bên dưới. Email này mang tính cá nhân và bạn không được chia sẻ nó với người khác.</mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">2+UP0ovKNHOpcbDzVsHWzVPG9B7L3fyA053oZhrpLfc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="a2cb7e16-7d68-4a2e-8753-e660f742fefb"><source>Your participation is voluntary. Should you find it necessary to take a break before finishing, you can always access the form again to complete it later. Your answers already provided will be saved automatically. Once you have completed your responses, you will no longer be able to go back and change them.</source><seg-source><mrk mtype="seg" mid="10">Your participation is voluntary. Should you find it necessary to take a break before finishing, you can always access the form again to complete it later. Your answers already provided will be saved automatically. Once you have completed your responses, you will no longer be able to go back and change them.</mrk></seg-source><target><mrk mtype="seg" mid="10">Việc tham gia của bạn là tự nguyện. Nếu bạn thấy cần nghỉ ngơi trước khi hoàn thành, bạn luôn có thể truy cập lại biểu mẫu này để hoàn thành sau. Câu trả lời của bạn đã cung cấp sẽ được lưu tự động và sẽ được xử lý bảo mật. Một khi bạn đã hoàn thành câu trả lời, bạn sẽ không thể quay trở lại thay đổi các câu trả lời.</mrk></target><sdl:seg-defs><sdl:seg id="10" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:01:56</sdl:value><sdl:value key="modified_on">05/05/2026 04:02:07</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1517659540</sdl:value><sdl:value key="SegmentIdentityHash">H4jxZzwGw7u5Of7X13DOqHRdCcphFd9IR/JlIEdHIsA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="5bfc2a66-7e46-4654-a954-1f79f5673bb5"><source><x id="34"/> <x id="35"/> <x id="36"/> <x id="37"/> <x id="38"/> <x id="39"/>  &lt;a href=&quot;https://survey.euro.confirmit.com/wix/<x id="40"/>.aspx?r=<x id="41"/>&amp;s=<x id="42"/>&amp;DC=1&quot; target=&quot;_blank&quot; style=&quot; border: 1px solid #a9b7ac; border-radius: 3px; font-family:Trebuchet MS, sans-serif; font-size: 13px; color: #ffffff; text-decoration: none; font-weight:bold; display: inline-block;<x id="43"/></source><seg-source><mrk mtype="seg" mid="11"><x id="34"/> <x id="35"/> <x id="36"/> <x id="37"/> <x id="38"/> <x id="39"/>  &lt;a href=&quot;https://survey.euro.confirmit.com/wix/<x id="40"/>.aspx?r=<x id="41"/>&amp;s=<x id="42"/>&amp;DC=1&quot; target=&quot;_blank&quot; style=&quot; border: 1px solid #a9b7ac; border-radius: 3px; font-family:Trebuchet MS, sans-serif; font-size: 13px; color: #ffffff; text-decoration: none; font-weight:bold; display: inline-block;<x id="43"/></mrk></seg-source><target><mrk mtype="seg" mid="11"><x id="34"/> <x id="35"/> <x id="36"/> <x id="37"/> <x id="35"/> <x id="39"/>  &lt;a href=&quot;https://survey.euro.confirmit.com/wix/<x id="40"/>.aspx?r=<x id="41"/>&amp;s=<x id="42"/>&amp;DC=1&quot; target=&quot;_blank&quot; style=&quot; border: 1px solid #a9b7ac; border-radius: 3px; font-family:Trebuchet MS, sans-serif; font-size: 13px; color: #ffffff; text-decoration: none; font-weight:bold; display: inline-block;<x id="43"/></mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">76IS9t43FSw/T+TP3dutk7x8M6Hw7G9A0Gg5Rp3c5Ig=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="ab0435c1-e380-4460-887d-9bf343d596bd"><source>Click here to participate</source><seg-source><mrk mtype="seg" mid="12">Click here to participate</mrk></seg-source><target><mrk mtype="seg" mid="12">Nhấn vào đây để tham gia</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">/5ASf9wQuY/b8OU3ipiSiqKWpO0wfEBh5OS2X9MhKLU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="1bc6847b-c04c-4a19-9a94-76be9c0d46e9"><source><g id="54"> </g> <x id="55"/> <x id="56"/> <x id="57"/> <x id="58"/> <x id="59"/> <x id="60"/></source><seg-source><mrk mtype="seg" mid="13"><g id="54"> </g> <x id="55"/> <x id="56"/> <x id="57"/> <x id="58"/> <x id="59"/> <x id="60"/></mrk></seg-source><target><mrk mtype="seg" mid="13"><g id="54"> </g> <x id="55"/> <x id="56"/> <x id="57"/> <x id="55"/> <x id="56"/> <x id="57"/></mrk></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">kwvaKG8MiR5GJP11wYeylLIcmKHiTScs+3VAHONZ2vA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="dc0b43e6-3863-4e4f-884d-0232eca0b570"><source>If you have any questions or problems</source><seg-source><mrk mtype="seg" mid="14">If you have any questions or problems</mrk></seg-source><target><mrk mtype="seg" mid="14">Nếu bạn có bất cứ thắc mắc hoặc vấn đề nào</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">VfANmRn6e1h27vNylDb50MJ1XCu1qNPrLjornle2dCc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="5e1d047b-d64e-4a44-a12c-7ce48a577a70"><source>If you have questions regarding the survey, please contact BSO Service Desk via  <g id="68">Service Portal Contact Page</g>. If you experience problems with the questionnaire, you are welcome to contact Ennova by e-mail LEGOGroup@ennova.com.</source><seg-source><mrk mtype="seg" mid="15">If you have questions regarding the survey, please contact BSO Service Desk via  <g id="68">Service Portal Contact Page</g>. If you experience problems with the questionnaire, you are welcome to contact Ennova by e-mail LEGOGroup@ennova.com.</mrk></seg-source><target><mrk mtype="seg" mid="15">Nếu bạn có các thắc mắc liên quan đến khảo sát, vui lòng liên hệ với Bộ Phận Dịch Vụ BSO qua <g id="68">Service Portal Contact Page</g>. Nếu bạn gặp vấn đề với bảng câu hỏi, bạn có thể liên hệ với Ennova qua email LEGOGroup@ennova.com.</mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">mBJqOA1dVKbsUJvKOICx175AVEfsX2FmRLIU34Dd9cY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="32dca72c-d162-4a21-8635-7b5cc76823ee"><source>We hope that you will take this opportunity to complete the survey. On behalf of the LEGO Group, we thank you for sharing your views.</source><seg-source><mrk mtype="seg" mid="16">We hope that you will take this opportunity to complete the survey. On behalf of the LEGO Group, we thank you for sharing your views.</mrk></seg-source><target><mrk mtype="seg" mid="16">Chúng tôi hy vọng bạn sẽ tận dụng cơ hội này để hoàn thành khảo sát. Thay mặt cho Tập Đoàn LEGO, chúng tôi xin cảm ơn bạn đã chia sẻ quan điểm của mình.</mrk></target><sdl:seg-defs><sdl:seg id="16" conf="Translated" origin="interactive" percent="100" text-match="SourceAndTarget"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:prev-origin/><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:06:39</sdl:value><sdl:value key="modified_on">05/05/2026 04:06:39</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1319379934</sdl:value><sdl:value key="SegmentIdentityHash">x6jNFSJBYALs1I/vtG4+koJNZYHB4x0OpgTLfNCbhzw=</sdl:value></sdl:prev-origin><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:06:39</sdl:value><sdl:value key="modified_on">05/05/2026 06:20:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1960008423</sdl:value><sdl:value key="SegmentIdentityHash">x6jNFSJBYALs1I/vtG4+koJNZYHB4x0OpgTLfNCbhzw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="fb6dbce8-2934-4264-91ae-3a2be0c6b6c8"><source>Kind regards,</source><seg-source><mrk mtype="seg" mid="17">Kind regards,</mrk></seg-source><target><mrk mtype="seg" mid="17">Xin chân thành cảm ơn!</mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">iMYoRnloAYavX5s3I/mYEoBAz+DPd/FoKUnYZ6I3CGA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="f1a182f9-31df-4154-9024-6a2b549b77a1"><source>Ennova</source><seg-source><mrk mtype="seg" mid="18">Ennova</mrk></seg-source><target><mrk mtype="seg" mid="18">Ennova</mrk></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">yV4Ka1uK3RFteZeeqLcv9JrKvuIE9c/FqECf7m5YxWQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="06f4c730-f380-44c8-9c16-86e67aa0a98f"><source>Processing personal data and your confidentiality</source><seg-source><mrk mtype="seg" mid="19">Processing personal data and your confidentiality</mrk></seg-source><target><mrk mtype="seg" mid="19">Xử lý dữ liệu cá nhân và bảo mật của bạn</mrk></target><sdl:seg-defs><sdl:seg id="19" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">5hObhm7nzLf69yAbUE1J+25q8KIxX13yBxIQP3gMrl8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="6b8413ba-1bef-49c5-8bd4-ea2ede0338ce"><source>Mid-Year People Pulse is carried out by our external survey provider (acting as a data processor) on behalf of your employer, the LEGO Group (acting as the data controller).</source><seg-source><mrk mtype="seg" mid="20">Mid-Year People Pulse is carried out by our external survey provider (acting as a data processor) on behalf of your employer, the LEGO Group (acting as the data controller).</mrk></seg-source><target><mrk mtype="seg" mid="20">Khảo sát People Pulse Giữa Năm được thực hiện bởi nhà cung cấp dịch vụ khảo sát bên ngoài của chúng tôi (đóng vai trò là đơn vị xử lý dữ liệu) thay mặt cho nhà tuyển dụng của bạn, Tập Đoàn LEGO (đóng vai trò là đơn vị kiểm soát dữ liệu).</mrk></target><sdl:seg-defs><sdl:seg id="20" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:07:18</sdl:value><sdl:value key="modified_on">05/05/2026 04:07:18</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1848539642</sdl:value><sdl:value key="SegmentIdentityHash">wQHg0wfoSefUgbX2kl4cSldjai0yfBdRWMLeaPaUD/A=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="86ec512a-e03c-4881-920c-248d93f59cde"><source>The LEGO Group has a legitimate interest in processing and collecting your personal data in Mid-Year People Pulse to understand and measure levels of satisfaction, motivation and opinions of employees.</source><seg-source><mrk mtype="seg" mid="21">The LEGO Group has a legitimate interest in processing and collecting your personal data in Mid-Year People Pulse to understand and measure levels of satisfaction, motivation and opinions of employees.</mrk></seg-source><target><mrk mtype="seg" mid="21">Tập Đoàn LEGO có lợi ích chính đáng trong việc xử lý và thu thập dữ liệu cá nhân của bạn trong khảo sát People Pulse Giữa Năm để hiểu và đánh giá mức độ hài lòng, động lực và ý kiến của nhân viên.</mrk></target><sdl:seg-defs><sdl:seg id="21" conf="Translated" origin="interactive" percent="100" text-match="SourceAndTarget"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:prev-origin/><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:08:31</sdl:value><sdl:value key="modified_on">05/05/2026 04:08:31</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1365043818</sdl:value><sdl:value key="SegmentIdentityHash">fh0e+sGZ7U2JXe27mWE8Ha/ErOtxVcClPYW2lqIVwhs=</sdl:value></sdl:prev-origin><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:08:31</sdl:value><sdl:value key="modified_on">05/05/2026 06:20:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2079530598</sdl:value><sdl:value key="SegmentIdentityHash">fh0e+sGZ7U2JXe27mWE8Ha/ErOtxVcClPYW2lqIVwhs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="99860b72-82aa-48c5-9bff-1b356ffb255c"><source>To administer the Mid-Year People Pulse and enable aggregated analysis, the LEGO Group will process certain personal data relating to you. This will include selected employment related data, such as LEGO e-mail address, ELT area, department name, team name, work location, seniority with the LEGO Group, salaried/non-salaried status, company code, job level or similar information but also full name, age and gender.</source><seg-source><mrk mtype="seg" mid="22">To administer the Mid-Year People Pulse and enable aggregated analysis, the LEGO Group will process certain personal data relating to you.</mrk> <mrk mtype="seg" mid="23">This will include selected employment related data, such as LEGO e-mail address, ELT area, department name, team name, work location, seniority with the LEGO Group, salaried/non-salaried status, company code, job level or similar information but also full name, age and gender.</mrk></seg-source><target><mrk mtype="seg" mid="22">Để quản lý khảo sát People Pulse Giữa Năm và tạo điều kiện phân tích tổng hợp, Tập Đoàn LEGO sẽ xử lý dữ liệu cá nhân nhất định liên quan đến bạn.</mrk> <mrk mtype="seg" mid="23">Thông tin này sẽ bao gồm dữ liệu chọn lọc liên quan đến công việc, chẳng hạn như địa chỉ email LEGO, khu vực ELT, tên phòng ban, tên đội ngũ, địa điểm làm việc, thâm niên với Tập Đoàn LEGO, tình trạng hưởng lương/không lương, mã công ty, cấp công việc hoặc thông tin tương tự nhưng cũng bao gồm họ tên, tuổi và giới tính.</mrk></target><sdl:seg-defs><sdl:seg id="22" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:08:56</sdl:value><sdl:value key="modified_on">05/05/2026 04:08:56</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-972712931</sdl:value><sdl:value key="SegmentIdentityHash">6KskV1IKVPa+Ms9HzuHm8oihnCxQTuepn6AuoqdWmxU=</sdl:value></sdl:seg><sdl:seg id="23" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:10:01</sdl:value><sdl:value key="modified_on">05/05/2026 04:10:01</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1395736333</sdl:value><sdl:value key="SegmentIdentityHash">+GMh9e/EtExh8ocAcXbuKip5+UPNc37fK932dUzNr0w=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="a8b6ade9-9378-4aea-827c-408590659c44"><source>It is also important to inform you that only the necessary personal data will be processed for Mid-Year People Pulse to achieve the above-mentioned purposes.</source><seg-source><mrk mtype="seg" mid="24">It is also important to inform you that only the necessary personal data will be processed for Mid-Year People Pulse to achieve the above-mentioned purposes.</mrk></seg-source><target><mrk mtype="seg" mid="24">Cũng cần thông tin cho bạn rằng chỉ có dữ liệu cá nhân cần thiết mới được xử lý cho khảo sát People Pulse Giữa Năm để đạt được các mục đích đã đề cập bên trên.</mrk></target><sdl:seg-defs><sdl:seg id="24" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:11:11</sdl:value><sdl:value key="modified_on">05/05/2026 04:11:11</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1363536537</sdl:value><sdl:value key="SegmentIdentityHash">aPChcBU1/2rm0jkRtsQg0lXM6Mn7hRQLLPDsnvjKSQ0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="4105d241-ff1c-4b7c-8bb3-1b9c96e18fb9"><source>By proceeding, you start the questionnaire where the LEGO Group will process your personal data in connection with Mid-Year People Pulse snapshot survey. For employees within the EU the legal basis is legitimate interest cf. GDPR, art. 6, 1(f).</source><seg-source><mrk mtype="seg" mid="25">By proceeding, you start the questionnaire where the LEGO Group will process your personal data in connection with Mid-Year People Pulse snapshot survey.</mrk> <mrk mtype="seg" mid="26">For employees within the EU the legal basis is legitimate interest cf. GDPR, art.</mrk> <mrk mtype="seg" mid="27">6, 1(f).</mrk></seg-source><target><mrk mtype="seg" mid="25">Bằng việc tiếp tục, bạn sẽ bắt đầu trả lời bảng câu hỏi, trong đó Tập Đoàn LEGO sẽ xử lý dữ liệu cá nhân của bạn liên quan đến khảo sát People Pulse snapshot Giữa Năm.</mrk> <mrk mtype="seg" mid="26">Đối với người lao động trong EU, cơ sở pháp lý là lợi ích hợp pháp theo GDPR, Điều</mrk> <mrk mtype="seg" mid="27">6, khoản 1(f).</mrk></target><sdl:seg-defs><sdl:seg id="25" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:11:15</sdl:value><sdl:value key="modified_on">05/05/2026 04:11:28</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">757049081</sdl:value><sdl:value key="SegmentIdentityHash">7t3ySFfRQgINz2CJdGffzwNs3s2Ukf3pakvmHxgGlWg=</sdl:value></sdl:seg><sdl:seg id="26" conf="Translated"><sdl:value key="SegmentIdentityHash">RSd/JdAdBhUi5nhvH9gCbCiZggirCkSvCxsvprjwjwg=</sdl:value></sdl:seg><sdl:seg id="27" conf="Translated"><sdl:value key="SegmentIdentityHash">W8J84VkVRuog2H63KNPTop0+kKoNamzbzTgvjik8A90=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="8ccc97ac-0e55-4611-aa00-6fe73267d7d9"><source>You can read more about the LEGO Group&apos;s processing of your personal data here:</source><seg-source><mrk mtype="seg" mid="28">You can read more about the LEGO Group&apos;s processing of your personal data here:</mrk></seg-source><target><mrk mtype="seg" mid="28">Bạn có thể tìm hiểu thêm về cách Tập đoàn LEGO xử lý dữ liệu cá nhân của bạn tại đây:</mrk></target><sdl:seg-defs><sdl:seg id="28" conf="Translated"><sdl:value key="SegmentIdentityHash">clGugjHUCxuyphBDvMBwubo8Emwi7iGT1+JaQO4sbIw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="9f44bee4-2872-497d-9a0e-5f62bf2b9b6f"><source><g id="70"><x id="71"/>Global Employee Privacy Policy.docx</g><x id="72"/></source><seg-source><mrk mtype="seg" mid="29"><g id="70"><x id="71"/>Global Employee Privacy Policy.docx</g><x id="72"/></mrk></seg-source><target><mrk mtype="seg" mid="29"><g id="70"><x id="71"/>Global Employee Privacy Policy.docx</g><x id="72"/></mrk></target><sdl:seg-defs><sdl:seg id="29" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">aJYCDSJKH0ko++B2CA+f4go29zNDGbiKOcunFkmTS+M=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="8b334799-7724-4b2a-a745-8910b95741e4"><source>Results from first section of the survey are only made available with a minimum of five responses. If you are in a team with less than five respondents, your answers will be included in a joint result.</source><seg-source><mrk mtype="seg" mid="30">Results from first section of the survey are only made available with a minimum of five responses.</mrk> <mrk mtype="seg" mid="31">If you are in a team with less than five respondents, your answers will be included in a joint result.</mrk></seg-source><target><mrk mtype="seg" mid="30">Kết quả từ phần đầu tiên của khảo sát chỉ được cung cấp với tối thiểu 5 câu trả lời.</mrk> <mrk mtype="seg" mid="31">Nếu nhóm của bạn có ít hơn năm người tham gia, câu trả lời của nhóm bạn sẽ được gộp vào một Kết quả chung.</mrk></target><sdl:seg-defs><sdl:seg id="30" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:13:13</sdl:value><sdl:value key="modified_on">05/05/2026 04:13:13</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1495315497</sdl:value><sdl:value key="SegmentIdentityHash">AgNEACgIOe29V/t+SF8mI92XGDk7avo5nCOaozZXSiU=</sdl:value></sdl:seg><sdl:seg id="31" conf="Translated"><sdl:rep id="KyGyegY62wF73WHAUraWnJ9uL5arWs1V6xqMpoivnZQ="/><sdl:value key="SegmentIdentityHash">KyGyegY62wF73WHAUraWnJ9uL5arWs1V6xqMpoivnZQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="f52e7be3-9efa-4c3f-8038-3596757be7ad"><source>Your individual identifiable responses to second section of the survey will be available to the LEGO Group, however access is strictly limited to a small number of employees within the People Insights &amp; Analytics team (a team of no more than 5 employees) in the LEGO Group who need this access for analysis purposes. Your individual identifiable responses will not be shared with People Leaders, People Partners, functional leaders or anyone else apart from the People Insights &amp; Analytics team. Your People Leaders, People Partners, functional leaders will only receive aggregated results with a minimum of five responses. If you are in a team with less than five respondents, your answers will be included in a joint result.</source><seg-source><mrk mtype="seg" mid="32">Your individual identifiable responses to second section of the survey will be available to the LEGO Group, however access is strictly limited to a small number of employees within the People Insights &amp; Analytics team (a team of no more than 5 employees) in the LEGO Group who need this access for analysis purposes.</mrk> <mrk mtype="seg" mid="33">Your individual identifiable responses will not be shared with People Leaders, People Partners, functional leaders or anyone else apart from the People Insights &amp; Analytics team.</mrk> <mrk mtype="seg" mid="34">Your People Leaders, People Partners, functional leaders will only receive aggregated results with a minimum of five responses.</mrk> <mrk mtype="seg" mid="35">If you are in a team with less than five respondents, your answers will be included in a joint result.</mrk></seg-source><target><mrk mtype="seg" mid="32">Các câu trả lời có thể nhận dạng cá nhân của bạn cho phần thứ hai của khảo sát sẽ được cung cấp cho Tập Đoàn LEGO, tuy nhiên quyền tiếp cận chỉ giới hạn ở một số ít nhân viên trong đội ngũ People Insights &amp; Analytics (một nhóm không quá 5 nhân viên) trong Tập Đoàn LEGO, họ cần quyền tiếp cận này cho mục đích phân tích.</mrk> <mrk mtype="seg" mid="33">Các câu trả lời có thể nhận dạng cá nhân của bạn sẽ không được chia sẻ với các Nhà Lãnh Đạo Nhân Sự, Đối Tác Nhân Sự, lãnh đạo bộ phận hoặc bất kỳ ai bên ngoài đội ngũ People Insights &amp; Analytics.</mrk> <mrk mtype="seg" mid="34">Các Nhà Lãnh Đạo Nhân Sự, Đối Tác Nhân Sự, các lãnh đạo bộ phận sẽ chỉ nhận được kết quả tổng hợp với tối thiểu 5 câu trả lời.</mrk> <mrk mtype="seg" mid="35">Nếu nhóm của bạn có ít hơn năm người tham gia, câu trả lời của nhóm bạn sẽ được gộp vào một Kết quả chung.</mrk></target><sdl:seg-defs><sdl:seg id="32" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="Source"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:01</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:01</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">290956172</sdl:value><sdl:value key="SegmentIdentityHash">Mp0E59yAIM4ySv0r05VuKuZp3d2krHo7YLTC2Rd45Mg=</sdl:value></sdl:seg><sdl:seg id="33" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:06</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:12</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-790938561</sdl:value><sdl:value key="SegmentIdentityHash">JCRipt7az4J+Yni59N3z1uaHE4WpF0LDZV7RHREgvzs=</sdl:value></sdl:seg><sdl:seg id="34" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:32</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:33</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1300353419</sdl:value><sdl:value key="SegmentIdentityHash">1pq5W3FzmUQWBgkhPvgTpO4o9gWb8sleFQR2YsmMFdM=</sdl:value></sdl:seg><sdl:seg id="35" conf="Translated"><sdl:rep id="KyGyegY62wF73WHAUraWnJ9uL5arWs1V6xqMpoivnZQ="/><sdl:value key="SegmentIdentityHash">KyGyegY62wF73WHAUraWnJ9uL5arWs1V6xqMpoivnZQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="7727862f-3a1b-4655-9724-d1cdc9ebadb5"><source>All responses are handled confidentially by the LEGO Group and are subject to appropriate technical and organisational measures to protect your personal data. Your individual responses will be transferred to Qualtrics for analytics as described above.</source><seg-source><mrk mtype="seg" mid="36">All responses are handled confidentially by the LEGO Group and are subject to appropriate technical and organisational measures to protect your personal data.</mrk> <mrk mtype="seg" mid="37">Your individual responses will be transferred to Qualtrics for analytics as described above.</mrk></seg-source><target><mrk mtype="seg" mid="36">Tất cả các câu trả lời được xử lý bảo mật bởi Tập Đoàn LEGO và phải tuân theo các biện pháp kỹ thuật và tổ chức thích hợp để bảo vệ dữ liệu cá nhân của bạn.</mrk> <mrk mtype="seg" mid="37">Các câu trả lời cá nhân của bạn sẽ được chuyển cho Qualtrics để phân tích như mô tả bên trên.</mrk></target><sdl:seg-defs><sdl:seg id="36" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="Source"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:45</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:46</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1878819933</sdl:value><sdl:value key="SegmentIdentityHash">Vf6ygW7SCixg9rW1nKryQ5TRoz3Oi4i7lUyQAoEeH4E=</sdl:value></sdl:seg><sdl:seg id="37" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:54</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:54</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2127712215</sdl:value><sdl:value key="SegmentIdentityHash">NiitDaLDJqcutWl7P6dmOfhjyiSJPRCs8CW8Hk7w1WE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="2ba84f3a-a473-45c0-82c9-9915f4ab3eaa"><source>If you want access to your data, want to have your data deleted or want to exercise another Privacy Right in the GDPR, you need to use the link above to make sure that your request will be well received and handled by the LEGO Group.</source><seg-source><mrk mtype="seg" mid="38">If you want access to your data, want to have your data deleted or want to exercise another Privacy Right in the GDPR, you need to use the link above to make sure that your request will be well received and handled by the LEGO Group.</mrk></seg-source><target><mrk mtype="seg" mid="38">Nếu bạn muốn truy cập dữ liệu của mình, muốn xóa dữ liệu hoặc muốn thực hiện một Quyền riêng tư khác theo GDPR, bạn cần sử dụng liên kết ở trên để đảm bảo yêu cầu của bạn được Tập đoàn LEGO tiếp nhận và xử lý đúng cách.</mrk></target><sdl:seg-defs><sdl:seg id="38" conf="Translated"><sdl:value key="SegmentIdentityHash">I3UoD6Fjs9Cy8Zgno+i3ACE+GPvRPK7FlQUWGD0ssV4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="1622c271-1279-4ee4-8a56-71dea1364302"><source>If you may have questions about how the LEGO Group is handling your personal data, you can ask the Data Protection Officer (DPO) - gdpr.hr@LEGO.com.</source><seg-source><mrk mtype="seg" mid="39">If you may have questions about how the LEGO Group is handling your personal data, you can ask the Data Protection Officer (DPO) - gdpr.hr@LEGO.com.</mrk></seg-source><target><mrk mtype="seg" mid="39">Nếu bạn có thể có thắc mắc về cách thức Tập Đoàn LEGO xử lý dữ liệu cá nhân của bạn, bạn có thể hỏi Cán Bộ Bảo Vệ Dữ Liệu (DPO) của Tập Đoàn LEGO - gdpr.hr@LEGO.com.</mrk></target><sdl:seg-defs><sdl:seg id="39" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="Source"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:15:14</sdl:value><sdl:value key="modified_on">05/05/2026 04:15:15</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-41229032</sdl:value><sdl:value key="SegmentIdentityHash">sdTh9HGDx7HUHmGCzVZ5Y3tMmldXV8QA62jG6jsJLjE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="f2f9d38a-ae2a-4f5d-aa97-89efd178167b"><source><x id="76"/> <x id="77"/> <x id="78"/> <x id="79"/> <x id="80"/> <x id="81"/> &lt;!--[if (gte mso 9)|(IE)]&gt; <x id="82"/> <x id="83"/> <x id="84"/> &lt;![endif]--&gt; <x id="85"/> <g id="86"> </g> <x id="87"/> <x id="88"/> <x id="89"/></source><seg-source><mrk mtype="seg" mid="40"><x id="76"/> <x id="77"/> <x id="78"/> <x id="79"/> <x id="80"/> <x id="81"/> &lt;!--[if (gte mso 9)|(IE)]&gt; <x id="82"/> <x id="83"/> <x id="84"/> &lt;![endif]--&gt; <x id="85"/> <g id="86"> </g> <x id="87"/> <x id="88"/> <x id="89"/></mrk></seg-source><target><mrk mtype="seg" mid="40"><x id="76"/> <x id="77"/> <x id="78"/> <x id="76"/> <x id="77"/> <x id="78"/> &lt;!--[if (gte mso 9)|(IE)]&gt; <x id="76"/> <x id="77"/> <x id="78"/> &lt;![endif]--&gt; <x id="85"/> <g id="86"> </g> <x id="76"/> <x id="77"/> <x id="78"/></mrk></target><sdl:seg-defs><sdl:seg id="40" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">juByt+B779pOdqkBWfQmmtpaTc/W28lWLb/jU4FPcnI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file></xliff>