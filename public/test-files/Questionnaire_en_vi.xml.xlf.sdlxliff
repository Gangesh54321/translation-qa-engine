l:value key="modified_on">05/05/2026 04:31:44</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:31:44</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:32:01</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:31:44</sdl:value><sdl:value key="SDL:ProjectTranslationHash">144055848</sdl:value><sdl:value key="SegmentIdentityHash">BODWyErkDE6MFecB2fRV4Wg6iJY=</sdl:value></sdl:seg><sdl:seg id="16" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:06</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:12</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-790938561</sdl:value><sdl:value key="SegmentIdentityHash">JCRipt7az4J+Yni59N3z1uaHE4WpF0LDZV7RHREgvzs=</sdl:value></sdl:seg><sdl:seg id="17" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:14:32</sdl:value><sdl:value key="modified_on">05/05/2026 04:14:33</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1300353419</sdl:value><sdl:value key="SegmentIdentityHash">1pq5W3FzmUQWBgkhPvgTpO4o9gWb8sleFQR2YsmMFdM=</sdl:value></sdl:seg><sdl:seg id="18" conf="Translated" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin origin="nmt" origin-system="Machine Translation"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">/+U+wLH3NNSDW7wTtBZ/IyjWN5Kbv98j/ru0BLiv4z4=</sdl:value></sdl:prev-origin><sdl:value key