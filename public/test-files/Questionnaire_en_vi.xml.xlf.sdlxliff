-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="74cdfb49-4dd4-4d22-8f86-119d6a4dd535"><source>Please assess the following statements:</source><seg-source><mrk mtype="seg" mid="75">Please assess the following statements:</mrk></seg-source><target><mrk mtype="seg" mid="75">Vui lòng đánh giá các phát biểu sau đây:</mrk></target><sdl:seg-defs><sdl:seg id="75" locked="true" conf="ApprovedTranslation"><sdl:rep id="Git1JaLfbbQ1/pDhWcU/aH8TUaMhBoWzBNO/IKUn1j8="/><sdl:value key="SegmentIdentityHash">Git1JaLfbbQ1/pDhWcU/aH8TUaMhBoWzBNO/IKUn1j8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="fd008d30-5de5-4244-bf07-c0eba7fc1681"><source>I feel safe and able to share my views and opinions</source><seg-source><mrk mtype="seg" mid="76">I feel safe and able to share my views and opinions</mrk></seg-source><target><mrk mtype="seg" mid="76">Tôi cảm thấy an toàn và có thể chia sẻ quan điểm và ý kiến của mình</mrk></target><sdl:seg-defs><sdl:seg id="76" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">TDINN+EHuR5USOyCwF47WK4t+4gxFk2HwWOaeUuC888=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="7e4a7206-ebdf-4846-9795-607a7681acc6"><source>My colleagues are living the Leadership Playground behaviors (brave, curious and focused)</source><seg-source><mrk mtype="seg" mid="77">My colleagues are living the Leadership Playground behaviors (brave, curious and focused)</mrk></seg-source><target><mrk mtype="seg" mid="77">Đồng nghiệp của tôi đang sống theo các hành vi Sân Chơi Lãnh Đạo (can đảm, tìm tòi và tập trung)</mrk></target><sdl:seg-defs><sdl:seg id="77" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">4sQo6/ysRxyvdPReIdTQZJmfpjFH5MKNSpoKtUMayCg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="5f999758-2ce2-4169-87fc-4887f2d84375"><source>I have a clear understanding of the 2026 Plan and how I am expected to contribute to the realisation of the plan</source><seg-source><mrk mtype="seg" mid="78">I have a clear understanding of the 2026 Plan and how I am expected to contribute to the realisation of the plan</mrk></seg-source><target><mrk mtype="seg" mid="78">Tôi hiểu rõ về Kế Hoạch 2026 và tôi được kỳ vọng sẽ đóng góp như thế nào vào việc hiện thực hóa kế hoạch</mrk></target><sdl:seg-defs><sdl:seg id="78" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">WxdJuSJZqCNdq4GRusdBWgmyudWvz0jT4RpehlXsY7w=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="84b150d2-897b-4ad5-83e7-1d8cf89b160b"><source>Wellbeing</source><seg-source><mrk mtype="seg" mid="79">Wellbeing</mrk></seg-source><target><mrk mtype="seg" mid="79">Sức khỏe và hạnh phúc</mrk></target><sdl:seg-defs><sdl:seg id="79" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">32pTL28E1PP/oFkybQIg5zJnKEvOaFFjEr2D1RtC5eY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="39f0802c-8f13-4118-ace5-c0c6983e7112"><source>Please assess the following statements:</source><seg-source><mrk mtype="seg" mid="80">Please assess the following statements:</mrk></seg-source><target><mrk mtype="seg" mid="80">Vui lòng đánh giá các phát biểu sau đây:</mrk></target><sdl:seg-defs><sdl:seg id="80" locked="true" conf="ApprovedTranslation"><sdl:rep id="Git1JaLfbbQ1/pDhWcU/aH8TUaMhBoWzBNO/IKUn1j8="/><sdl:value key="SegmentIdentityHash">Git1JaLfbbQ1/pDhWcU/aH8TUaMhBoWzBNO/IKUn1j8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="6b6f3e9a-82f0-4853-9fd4-42aab0a13cc0"><source>I am happy at work most of the time</source><seg-source><mrk mtype="seg" mid="81">I am happy at work most of the time</mrk></seg-source><target><mrk mtype="seg" mid="81">Tôi cảm thấy vui vẻ tại nơi làm việc hầu hết thời gian</mrk></target><sdl:seg-defs><sdl:seg id="81" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">qfDr/w3I13mlC3KUqt54wCs+uefo4Rt3/tNA6z+e0zI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="61e271c8-49d9-4d23-82ec-f479c0c36939"><source>My work at the LEGO Group has a clear sense of purpose</source><seg-source><mrk mtype="seg" mid="82">My work at the LEGO Group has a clear sense of purpose</mrk></seg-source><target><mrk mtype="seg" mid="82">Công việc của tôi ở Tập Đoàn LEGO có mục đích rõ ràng</mrk></target><sdl:seg-defs><sdl:seg id="82" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">T2huGHh7M8EdomCGYKWF0fKB53lIHvdNkmjcrpup10A=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="2e9ec4e8-6ec1-4c9f-8e1a-6d007b6fe244"><source>The amount of stress in my job is manageable most of the time</source><seg-source><mrk mtype="seg" mid="83">The amount of stress in my job is manageable most of the time</mrk></seg-source><target><mrk mtype="seg" mid="83">Mức căng thẳng trong công việc của tôi là có thể kiểm soát được trong phần lớn trường hợp</mrk></target><sdl:seg-defs><sdl:seg id="83" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:33:47</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:33:47</sdl:value><sdl:value key="SDL:ProjectTranslationHash">135690101</sdl:value><sdl:value key="SegmentIdentityHash">07kndq4Gq9gNJT61kpJqvji1nto=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="87187abb-52e5-48ea-82a1-e9c4e8b253fa"><source>Demographics</source><seg-source><mrk mtype="seg" mid="84">Demographics</mrk></seg-source><target><mrk mtype="seg" mid="84">Nhóm đối tượng</mrk></target><sdl:seg-defs><sdl:seg id="84" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">DD8TPrxdcqRtpUf9L/n7y1kwxLP/LNas+PQgV2y3vvQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="6ca41de2-5c4b-44dc-9c85-bceb5bc33571"><source>Results relating to this question will only be available in the LEGO Group report, ELT areas, organisations directly reporting to the ELT area and locations exceeding 20 answers. Please note you can select ‘prefer not to say’ for this question.</source><seg-source><mrk mtype="seg" mid="85">Results relating to this question will only be available in the LEGO Group report, ELT areas, organisations directly reporting to the ELT area and locations exceeding 20 answers. Please note you can select ‘prefer not to say’ for this question.</mrk></seg-source><target><mrk mtype="seg" mid="85">Các kết quả liên quan đến câu hỏi này sẽ chỉ có trong báo cáo của Tập Đoàn LEGO, các khu vực ELT, các tổ chức trực tiếp báo cáo cho khu vực ELT và các cơ sở có nhiều hơn 20 câu trả lời. Vui lòng lưu ý rằng bạn có thể chọn &apos;không muốn trả lời&apos; cho câu hỏi này.</mrk></target><sdl:seg-defs><sdl:seg id="85" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">nQ49R7sh2v5D6A61Be7XLSdaPYC04MWfWpV5nERqv6c=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="878b1856-0d9e-4a20-84bd-ec5d7740a65d"><source>Do you identify as part of any minority groups in the country where you are based? This could include but is not limited to gender, race/ethnicity, disability, sexual orientation, religion, nationality and/or cultural background.</source><seg-source><mrk mtype="seg" mid="86">Do you identify as part of any minority groups in the country where you are based? This could include but is not limited to gender, race/ethnicity, disability, sexual orientation, religion, nationality and/or cultural background.</mrk></seg-source><target><mrk mtype="seg" mid="86">Bạn có xem mình là thành viên của bất kỳ nhóm thiểu số nào ở quốc gia nơi bạn hoạt động không? Điều này có thể bao gồm nhưng không giới hạn ở giới tính, chủng tộc/sắc tộc, khuyết tật, thiên hướng tình dục, tôn giáo, quốc tịch và/hoặc nền tảng văn hóa.</mrk></target><sdl:seg-defs><sdl:seg id="86" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">U/m6mcqmPYT5LTb+fsMxCFYJe7TO7FIQyg3VDYligRI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="a3b076fb-8410-4923-9e23-9510d5ed08eb"><source>Yes</source><seg-source><mrk mtype="seg" mid="87">Yes</mrk></seg-source><target><mrk mtype="seg" mid="87">Có</mrk></target><sdl:seg-defs><sdl:seg id="87" locked="true" conf="ApprovedTranslation"><sdl:rep id="qAdHPDhNG6TkzxWVVo3vnDhh3RttyuGVLbj1darSb6s="/><sdl:value key="SegmentIdentityHash">qAdHPDhNG6TkzxWVVo3vnDhh3RttyuGVLbj1darSb6s=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="d2f25768-edf1-45ef-9ca4-df6b95a81ed7"><source>No</source><seg-source><mrk mtype="seg" mid="88">No</mrk></seg-source><target><mrk mtype="seg" mid="88">Không</mrk></target><sdl:seg-defs><sdl:seg id="88" locked="true" conf="ApprovedTranslation"><sdl:rep id="/qoF/E3afYWKdcXcnQfzPWeEYqwd3Ipdk+rNxiMpxaU="/><sdl:value key="SegmentIdentityHash">/qoF/E3afYWKdcXcnQfzPWeEYqwd3Ipdk+rNxiMpxaU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="6879286f-9c1e-4a33-b135-242dcaec8d0c"><source>Prefer not to say</source><seg-source><mrk mtype="seg" mid="89">Prefer not to say</mrk></seg-source><target><mrk mtype="seg" mid="89">Không muốn trả lời</mrk></target><sdl:seg-defs><sdl:seg id="89" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">8Kj57ubYoYvfOkS4Piqz3ywhe0/jgcUYyop+pTUw3KU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="5f3e529b-30ce-4d85-9785-8e01514b9654"><source>Open comments</source><seg-source><mrk mtype="seg" mid="90">Open comments</mrk></seg-source><target><mrk mtype="seg" mid="90">Nhận xét mở</mrk></target><sdl:seg-defs><sdl:seg id="90" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">fpgCzPMkXbw4y2++mx7fUPTyCJLl58WYccLhg0Z8fi0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="d58fa1fb-513a-4dd2-b6a1-9d43d7209d26"><source>Please note that your comments will be directly included in an unedited format to the LEGO Group. Comments will be included in the language in which they are written. If possible please write in English.</source><seg-source><mrk mtype="seg" mid="91">Please note that your comments will be directly included in an unedited format to the LEGO Group. Comments will be included in the language in which they are written. If possible please write in English.</mrk></seg-source><target><mrk mtype="seg" mid="91">Vui lòng lưu ý rằng ý kiến của bạn sẽ được gửi trực tiếp đến LEGO Group ở định dạng chưa chỉnh sửa. Nhận xét sẽ được giữ nguyên trên ngôn ngữ bạn sử dụng. Nếu có thể, vui lòng viết bằng tiếng Anh.</mrk></target><sdl:seg-defs><sdl:seg id="91" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">o7thxDsqQ5KdZ0c77D3agITTOlZ1dTw9vGqpJqBPaN8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="ed6266eb-e723-436c-b7e7-6a6d777a6898"><source>How can we ensure the LEGO Group continues to be a great place to work?</source><seg-source><mrk mtype="seg" mid="92">How can we ensure the LEGO Group continues to be a great place to work?</mrk></seg-source><target><mrk mtype="seg" mid="92">Làm sao để Tập Đoàn LEGO tiếp tục là một nơi làm việc tuyệt vời?</mrk></target><sdl:seg-defs><sdl:seg id="92" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">w/HiaI16lmqRjQ8ldQU4OuR1LdHiBReLhB0pdmGc/Zc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="7c5038c0-4ee3-47be-8309-27a9380268f7"><source>Please do not share information in your answer that identifies you and/or other employees to ensure confidentiality, for example no names, personal characteristics, team, etc.</source><seg-source><mrk mtype="seg" mid="93">Please do not share information in your answer that identifies you and/or other employees to ensure confidentiality, for example no names, personal characteristics, team, etc.</mrk></seg-source><target><mrk mtype="seg" mid="93">Vui lòng không chia sẻ thông tin trong câu trả lời có thể nhận dạng bạn và/hoặc các nhân viên khác để đảm bảo tính bảo mật, ví dụ như không chia sẻ tên, đặc điểm cá nhân, nhóm, v.v.</mrk></target><sdl:seg-defs><sdl:seg id="93" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">L8whBsI6fQNfxR0hmHj5+r1ebPBKNAgQ+k97ptI5zmA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="33340ad9-dab7-4886-a439-d9cc03470bef"><source>Thank you for your responses. <x id="124"/><x id="125"/>You are now completing the first part of the survey. By clicking &quot;OK&quot;, you will submit the answers you have given so far and thus permitting us to use these in the analysis and reports. <x id="126"/><x id="127"/>Please note that you will no longer have access to this part of the questionnaire once you submit your answers.<x id="128"/><x id="129"/></source><seg-source><mrk mtype="seg" mid="94">Thank you for your responses. <x id="124"/><x id="125"/>You are now completing the first part of the survey. By clicking &quot;OK&quot;, you will submit the answers you have given so far and thus permitting us to use these in the analysis and reports. <x id="126"/><x id="127"/>Please note that you will no longer have access to this part of the questionnaire once you submit your answers.<x id="128"/><x id="129"/></mrk></seg-source><target><mrk mtype="seg" mid="94">Cảm ơn các câu trả lời của bạn.  <x id="124"/><x id="124"/>Bây giờ bạn đang hoàn thành phần đầu tiên của khảo sát. Bằng cách nhấp vào &quot;OK&quot;, bạn sẽ gửi các câu trả lời bạn đã đưa ra cho đến thời điểm này và cho phép chúng tôi sử dụng những câu trả lời này trong phân tích và báo cáo.  <x id="124"/><x id="124"/>Vui lòng lưu ý rằng bạn sẽ không còn quyền truy cập vào phần này của bảng câu hỏi một khi bạn gửi câu trả lời của mình.<x id="124"/><x id="124"/></mrk></target><sdl:seg-defs><sdl:seg id="94" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">56pOKXlscc9OIgN2mwZWuoEK205I78pHhs+TNLgDAIk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="46825246-a3f5-44a0-b39a-c63e658cff03"><source>Additional questions</source><seg-source><mrk mtype="seg" mid="95">Additional questions</mrk></seg-source><target><mrk mtype="seg" mid="95">Các câu hỏi bổ sung</mrk></target><sdl:seg-defs><sdl:seg id="95" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:37:53</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:37:52</sdl:value><sdl:value key="SegmentIdentityHash">vaIDef1bB6KlwZqo2YQzLIpkaSM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="5721ff63-aeee-4df3-99e6-885ee814cba3"><source>Thank you for sharing your views in our Mid-Year People Pulse, helping us to uphold our People Promise to ensure everyone can succeed and grow together. <x id="136"/><x id="137"/>This year, to better understand your experience of working at the LEGO Group, we have included an extra set of questions around engagement, which are outlined below. These 10 questions are entirely voluntary and the results from these new questions will not be included in our standard reporting.<x id="138"/><x id="139"/>Your individual identifiable responses to these 10 questions will be available to the LEGO Group who will share the individual identifiable responses with Qualtrics. The LEGO Group is piloting Qualtrics as a potential new survey technology provider.<x id="140"/><x id="141"/>This means a limited number of colleagues in the People Insights &amp; Analytics team will have access to the individual identifiable responses for analytical purposes. The LEGO Group will use Qualtrics’ platform to build a new dashboard to analyse and assess responses and trends.<x id="142"/><x id="143"/>Individual identifiable responses will not be shared with People Leaders, People Partners, functional leaders or anyone outside the People Insights &amp; Analytics team. All responses will be handled confidentially and are subject to appropriate technical and organisational measures to protect personal data.<x id="144"/><x id="145"/>Thank you for your support.</source><seg-source><mrk mtype="seg" mid="96">Thank you for sharing your views in our Mid-Year People Pulse, helping us to uphold our People Promise to ensure everyone can succeed and grow together.</mrk> <mrk mtype="seg" mid="97"><x id="136"/><x id="137"/>This year, to better understand your experience of working at the LEGO Group, we have included an extra set of questions around engagement, which are outlined below.</mrk> <mrk mtype="seg" mid="98">These 10 questions are entirely voluntary and the results from these new questions will not be included in our standard reporting.<x id="138"/><x id="139"/>Your individual identifiable responses to these 10 questions will be available to the LEGO Group who will share the individual identifiable responses with Qualtrics.</mrk> <mrk mtype="seg" mid="99">The LEGO Group is piloting Qualtrics as a potential new survey technology provider.<x id="140"/><x id="141"/>This means a limited number of colleagues in the People Insights &amp; Analytics team will have access to the individual identifiable responses for analytical purposes.</mrk> <mrk mtype="seg" mid="100">The LEGO Group will use Qualtrics’ platform to build a new dashboard to analyse and assess responses and trends.<x id="142"/><x id="143"/>Individual identifiable responses will not be shared with People Leaders, People Partners, functional leaders or anyone outside the People Insights &amp; Analytics team.</mrk> <mrk mtype="seg" mid="101">All responses will be handled confidentially and are subject to appropriate technical and organisational measures to protect personal data.<x id="144"/><x id="145"/>Thank you for your support.</mrk></seg-source><target><mrk mtype="seg" mid="96">Xin cảm ơn bạn đã chia sẻ quan điểm của mình trong khảo sát People Pulse Giữa Năm, giúp chúng tôi giữ vững Cam Kết Với Nhân Viên nhằm đảm bảo mọi người đều có thể cùng nhau thành công và phát triển.</mrk> <mrk mtype="seg" mid="97"><x id="136"/><x id="137"/>Năm nay, để hiểu rõ hơn về trải nghiệm làm việc của bạn tại Tập Đoàn LEGO, chúng tôi đã đưa vào một bộ câu hỏi bổ sung về mức gắn kết, được trình bày bên dưới.</mrk> <mrk mtype="seg" mid="98">10 câu hỏi này là hoàn toàn tự nguyện và kết quả từ những câu hỏi mới này sẽ không được đưa vào báo cáo tiêu chuẩn của chúng tôi.<x id="138"/><x id="139"/>Các câu trả lời có thể nhận dạng cá nhân của bạn cho 10 câu hỏi này sẽ được cung cấp cho Tập Đoàn LEGO, họ sẽ chia sẻ các câu trả lời có thể nhận dạng cá nhân với Qualtrics.</mrk> <mrk mtype="seg" mid="99">Tập Đoàn LEGO đang thí điểm thuê Qualtrics như một nhà cung cấp công nghệ khảo sát mới tiềm năng.<x id="140"/><x id="141"/>Điều này có nghĩa là một số lượng hạn chế đồng nghiệp trong đội ngũ People Insights &amp; Analytics (Phân Tích Nhân Sự) sẽ có quyền tiếp cận các câu trả lời có thể nhận dạng cá nhân cho mục đích phân tích.</mrk> <mrk mtype="seg" mid="100">Tập Đoàn LEGO sẽ sử dụng nền tảng của Qualtrics để xây dựng một bảng chỉ số mới nhằm phân tích và đánh giá các câu trả lời và xu hướng.<x id="142"/><x id="143"/>Các Nhà Lãnh Đạo Nhân Sự, Đối Tác Nhân Sự, lãnh đạo bộ phận hoặc bất kỳ ai bên ngoài đội ngũ People Insights &amp; Analytics.</mrk> <mrk mtype="seg" mid="101">Tất cả các câu trả lời sẽ được xử lý bảo mật và tuân theo các biện pháp kỹ thuật và tổ chức thích hợp để bảo vệ dữ liệu cá nhân.<x id="144"/><x id="145"/>Xin cảm ơn sự hỗ trợ của bạn.</mrk></target><sdl:seg-defs><sdl:seg id="96" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="modified_on">05/05/2026 06:48:33</sdl:value><sdl:value key="created_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="created_on">05/05/2026 06:48:33</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1823082552</sdl:value><sdl:value key="SegmentIdentityHash">Yet8sHST3WO6Adb8FW0pp7sZslg=</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1671744708</sdl:value></sdl:seg><sdl:seg id="97" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:34:52</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:34:51</sdl:value><sdl:value key="SDL:ProjectTranslationHash">162008484</sdl:value><sdl:value key="SegmentIdentityHash">QR+EObnNMPBnpQ15nDLxSYLYSXk=</sdl:value></sdl:seg><sdl:seg id="98" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:35:16</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:35:16</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1375111453</sdl:value><sdl:value key="SegmentIdentityHash">cf4ZSGqZjaWQuBMb9ButmEibSkA=</sdl:value></sdl:seg><sdl:seg id="99" conf="Translated" origin="interactive" percent="71"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="71"><sdl:prev-origin origin="interactive"><sdl:prev-origin origin="nmt" origin-system="Machine Translation"><sdl:prev-origin/><sdl:value key="SegmentI