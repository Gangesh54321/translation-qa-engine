g id="101" conf="Translated" origin="interactive" percent="82"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="82"><sdl:prev-origin origin="nmt" origin-system="Machine Translation"><sdl:value key="SegmentIdentityHash">/wGAj3Gsbw9SlEjMB7GKaBVbXG/ItZVO9FyvFyyTazY=</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:35:58</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:35:58</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="modified_on">05/05/2026 06:48:56</sdl:value><sdl:value key="created_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="created_on">05/05/2026 06:48:56</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1668972139</sdl:value><sdl:value key="SegmentIdentityHash">464D3+kOde/DV2ESf8n6+4LDV3Q=</sdl:value><sdl:value key="SDL:OriginalTranslationHash">378411390</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="dcf66091-69b7-496f-a022-1c3f8c6d1a1a"><source>Overall, I am satisfied with the LEGO Group as a place to work</source><seg-source><mrk mtype="seg" mid="102">Overall, I am satisfied with the LEGO Group as a place to work</mrk></seg-source><target><mrk mtype="seg" mid="102">Nói chung, tôi hài lòng với Tập Đoàn LEGO như một nơi làm việc</mrk></target><sdl:seg-defs><sdl:seg id="102" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:36:18</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:36:16</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1360035722</sdl:value><sdl:value key="SegmentIdentityHash">wpySzLxN2wqeuEMTcu7eHd9MEpU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="b2548a0d-c3f1-4438-a117-032aa2839606"><source>Strongly disagree</source><seg-source><mrk mtype="seg" mid="103">Strongly disagree</mrk></seg-source><target><mrk mtype="seg" mid="103">Rất không đồng ý</mrk></target><sdl:seg-defs><sdl:seg id="103" locked="true" conf="Translated" origin="tm" origin-system="Ennova_master TM_EN-VI" percent="100"><sdl:rep id="A5hdj8ubBfc38pD5B2VGYK+i3Ds9RM1cSaqC3H2wfdo="/><sdl:value key="created_by">NTNSURFACEPRO4\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">02/18/2017 09:53:54</sdl:value><sdl:value key="modified_on">01/28/2021 07:35:56</sdl:value><sdl:value key="last_modified_by">win7-PC\win7</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-521140449</sdl:value><sdl:value key="SegmentIdentityHash">A5hdj8ubBfc38pD5B2VGYK+i3Ds9RM1cSaqC3H2wfdo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="8c074964-375b-414e-9f86-ab26ebdbe25c"><source>Strongly agree</source><seg-source><mrk mtype="seg" mid="104">Strongly agree</mrk></seg-source><target><mrk mtype="seg" mid="104">Rất đồng ý</mrk></target><sdl:seg-defs><sdl:seg id="104" locked="true" conf="Translated" origin="tm" origin-system="Ennova_master TM_EN-VI" percent="100" text-match="SourceAndTarget"><sdl:rep id="L4DHWcdmOf4hK+n1SH/UdSG5AqJBvseNhKu6yXibNmg="/><sdl:value key="created_by">NTNSURFACEPRO4\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">02/18/2017 09:54:00</sdl:value><sdl:value key="modified_on">01/28/2021 07:35:56</sdl:value><sdl:value key="last_modified_by">win7-PC\win7</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1115425396</sdl:value><sdl:value key="SegmentIdentityHash">L4DHWcdmOf4hK+n1SH/UdSG5AqJBvseNhKu6yXibNmg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="a0f734ea-a07e-48d8-ba15-34b39482647e"><source>Do not know</source><seg-source><mrk mtype="seg" mid="105">Do not know</mrk></seg-source><target><mrk mtype="seg" mid="105">Không biết</mrk></target><sdl:seg-defs><sdl:seg id="105" locked="true" conf="Translated" origin="tm" origin-system="Ennova_master TM_EN-VI" percent="100" text-match="SourceAndTarget"><sdl:rep id="iKns/jaiIVThZeWw2NtCG/ghgKM+d6ZR4gpiID74tIM="/><sdl:value key="created_by">NTNVIRTUALWINXP\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">03/17/2018 10:12:57</sdl:value><sdl:value key="modified_on">01/28/2021 07:35:56</sdl:value><sdl:value key="last_modified_by">win7-PC\win7</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1190058680</sdl:value><sdl:value key="SegmentIdentityHash">iKns/jaiIVThZeWw2NtCG/ghgKM+d6ZR4gpiID74tIM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="48447944-319f-4479-b5b9-a8f15de8abe0"><source>The LEGO Group inspires me to do my best work</source><seg-source><mrk mtype="seg" mid="106">The LEGO Group inspires me to do my best work</mrk></seg-source><target><mrk mtype="seg" mid="106">Tập Đoàn LEGO mang lại cho tôi cảm hứng để nỗ lực hết sức</mrk></target><sdl:seg-defs><sdl:seg id="106" conf="Translated" origin="interactive" percent="84"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="84"><sdl:prev-origin origin="interactive"><sdl:prev-origin origin="nmt" origin-system="Machine Translation"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">GmgLKlGxMFUr67+SwcnnRFuKPW5S2+08wBGcxmDZWJM=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">GmgLKlGxMFUr67+SwcnnRFuKPW5S2+08wBGcxmDZWJM=</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:36:20</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:36:26</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:36:26</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:36:31</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:36:26</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-363154301</sdl:value><sdl:value key="SegmentIdentityHash">Thrj95ZY1Rnv9esyZD3jE5kxMZE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="77819a9b-6f20-4756-a311-663480527f14"><source>I feel a sense of purpose from my work</source><seg-source><mrk mtype="seg" mid="107">I feel a sense of purpose from my work</mrk></seg-source><target><mrk mtype="seg" mid="107">Tôi cảm nhận ý thức mục đích từ công việc của mình</mrk></target><sdl:seg-defs><sdl:seg id="107" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:36:46</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:36:40</sdl:value><sdl:value key="SDL:ProjectTranslationHash">355118449</sdl:value><sdl:value key="SegmentIdentityHash">PLlp3FSnymsjdAaD+rK200vpVC0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="9e87fd62-5569-45e2-861a-12a109669cba"><source>I am proud to work for the LEGO Group</source><seg-source><mrk mtype="seg" mid="108">I am proud to work for the LEGO Group</mrk></seg-source><target><mrk mtype="seg" mid="108">Tôi tự hào được làm việc cho Tập Đoàn LEGO</mrk></target><sdl:seg-defs><sdl:seg id="108" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:36:51</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:36:51</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1494677257</sdl:value><sdl:value key="SegmentIdentityHash">4LKgPp3KFbeIG3oN6s/TwFvRbos=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="60771826-47b4-4ea7-b2de-c7de4659c7db"><source>I generally look forward to going to work</source><seg-source><mrk mtype="seg" mid="109">I generally look forward to going to work</mrk></seg-source><target><mrk mtype="seg" mid="109">Tôi thường mong chờ tới lúc đi làm</mrk></target><sdl:seg-defs><sdl:seg id="109" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:37:04</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:36:57</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1355340802</sdl:value><sdl:value key="SegmentIdentityHash">3wnijXAfxEm/ehp6Cb9YdtA57qk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="74616fb4-2c62-4af9-8a4d-5b3381490bb2"><source>I would recommend the LEGO Group to people I know as a great place to work</source><seg-source><mrk mtype="seg" mid="110">I would recommend the LEGO Group to people I know as a great place to work</mrk></seg-source><target><mrk mtype="seg" mid="110">Tôi sẽ giới thiệu Tập Đoàn LEGO cho những người mà tôi biết như một nơi làm việc tuyệt vời</mrk></target><sdl:seg-defs><sdl:seg id="110" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:37:15</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:37:15</sdl:value><sdl:value key="SDL:ProjectTranslationHash">27594052</sdl:value><sdl:value key="SegmentIdentityHash">FAIgo8s0ZmkkgLGOBONjVem0pPs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="964e6027-2887-4fb0-b3ec-aeb23a31d38b"><source>I intend to stay with the LEGO Group for the next 12 months</source><seg-source><mrk mtype="seg" mid="111">I intend to stay with the LEGO Group for the next 12 months</mrk></seg-source><target><mrk mtype="seg" mid="111">Tôi có ý định ở lại với Tập Đoàn LEGO trong 12 tháng tới</mrk></target><sdl:seg-defs><sdl:seg id="111" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:37:25</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:37:25</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1343984906</sdl:value><sdl:value key="SegmentIdentityHash">1qg5+2HgelnXyi6fEXKq04C5PlU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="96adf7b8-8650-4cc9-8914-32cf7e6fcaca"><source>The LEGO Group motivates me to contribute more than is normally required to complete my work</source><seg-source><mrk mtype="seg" mid="112">The LEGO Group motivates me to contribute more than is normally required to complete my work</mrk></seg-source><target><mrk mtype="seg" mid="112">Tập Đoàn LEGO khích lệ tôi đóng góp nhiều hơn mức bình thường cần thiết để hoàn thành công việc của mình</mrk></target><sdl:seg-defs><sdl:seg id="112" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:37:37</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:37:33</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1914443950</sdl:value><sdl:value key="SegmentIdentityHash">WcmYo9FD12JUg+hBkuFMUdnUQDc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="06a693c2-5558-45ad-aa8e-67f6745e09d6"><source>My work gives me a feeling of personal accomplishment</source><seg-source><mrk mtype="seg" mid="113">My work gives me a feeling of personal accomplishment</mrk></seg-source><target><mrk mtype="seg" mid="113">Công việc của tôi mang lại cho tôi cảm giác thành tựu cá nhân</mrk></target><sdl:seg-defs><sdl:seg id="113" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:37:41</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:37:41</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1873629437</sdl:value><sdl:value key="SegmentIdentityHash">Pvq+aiehflMZ5Rfcs4FcnO23hgc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="7a332d41-155b-4ed2-9a7b-46510476e3f2"><source>I rarely think about looking for a new job with another company</source><seg-source><mrk mtype="seg" mid="114">I rarely think about looking for a new job with another company</mrk></seg-source><target><mrk mtype="seg" mid="114">Tôi hiếm khi nghĩ đến việc tìm một công việc mới với một công ty khác</mrk></target><sdl:seg-defs><sdl:seg id="114" conf="Translated" origin="interactive" percent="99"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="99"><sdl:prev-origin origin="nmt" origin-system="Machine Translation"><sdl:value key="SegmentIdentityHash">6Wxjub5n4T+3WpQTAo5i9eSFH2ZaYPMv54UBPbyoEoI=</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:37:44</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:37:44</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:37:46</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:37:44</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1149556940</sdl:value><sdl:value key="SegmentIdentityHash">VI7KXfWvPnX/0bh021RggBKIwEc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="b9eee4bc-3e89-426a-b61b-67acd55a00c0"><source>Please submit your answers by pressing &quot;OK&quot; and thus permitting us to use your response in the analysis and reporting.<x id="146"/>When you have submitted your answers, you can no longer access the questionnaire.<x id="147"/></source><seg-source><mrk mtype="seg" mid="115">Please submit your answers by pressing &quot;OK&quot; and thus permitting us to use your response in the analysis and reporting.<x id="146"/>When you have submitted your answers, you can no longer access the questionnaire.<x id="147"/></mrk></seg-source><target><mrk mtype="seg" mid="115">Vui lòng gửi các câu trả lời của bạn bằng cách nhấn &quot;OK&quot; và từ đó chúng tôi được phép sử dụng câu trả lời của bạn cho việc phân tích và báo cáo.<x id="146"/>Khi bạn đã gửi câu trả lời, bạn không thể truy cập bảng câu hỏi nữa.<x id="146"/></mrk></target><sdl:seg-defs><sdl:seg id="115" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">V3nsSOmGdwdNfP4i2Z2UTPZZPS+7FBHLNQG5lk9nxeQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file></xliff>