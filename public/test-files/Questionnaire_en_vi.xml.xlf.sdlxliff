ncludeWithText">&lt;br&gt;</ph><props><value key="OriginalEmbeddedContent">&lt;br&gt;</value></props></tag><tag id="143"><ph name="br" line-wrap="false" word-end="false" seg-hint="IncludeWithText">&lt;br&gt;</ph><props><value key="OriginalEmbeddedContent">&lt;br&gt;</value></props></tag><tag id="144"><ph name="br" line-wrap="false" word-end="false" seg-hint="IncludeWithText">&lt;br&gt;</ph><props><value key="OriginalEmbeddedContent">&lt;br&gt;</value></props></tag><tag id="145"><ph name="br" line-wrap="false" word-end="false" seg-hint="IncludeWithText">&lt;br&gt;</ph><props><value key="OriginalEmbeddedContent">&lt;br&gt;</value></props></tag><tag id="146"><ph name="br" line-wrap="false" word-end="false" seg-hint="IncludeWithText">&lt;br&gt;</ph><props><value key="OriginalEmbeddedContent">&lt;br&gt;</value></props></tag><tag id="147"><ph name="br" line-wrap="false" word-end="false" seg-hint="IncludeWithText">&lt;br&gt;</ph><props><value key="OriginalEmbeddedContent">&lt;br&gt;</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="d18d4c27-6295-48fb-aa0c-95c22df40bd3"><source><g id="0">Dear LEGO</g><g id="1"><x id="2"/>®</g><x id="3"/><g id="4"> colleague,</g><x id="5"/><x id="6"/>Welcome to our Mid-Year Pulse Snapshot Survey.<x id="7"/><x id="8"/>Research consistently shows a strong link between employee engagement and company performance - and we see this clearly at the LEGO Group, where strong business results go hand in hand with record high levels of motivation and satisfaction. Our quarterly and annual People Pulse surveys are an important way to listen to you, helping us collectively understand your experiences and take meaningful actions that enhance motivation, satisfaction, and pride in our workplaces. <x id="9"/><x id="10"/>Our Mid-Year Pulse is especially valuable, providing timely data to identify and address any emerging opportunities and track our progress.<x id="11"/><x id="12"/> Please take 5-10 minutes to let us know what we are doing well and where there are opportunities to do even better to enable you and the wider organisation to achieve our mission. This is a great opportunity for you to share your thoughts and provide us with your valuable feedback.<x id="13"/><x id="14"/>Thank you in advance for your participation and for helping us on our journey to make the LEGO Group a unique and world-class workplace.<x id="15"/><x id="16"/><x id="17"/>Daan</source><seg-source><mrk mtype="seg" mid="1"><g id="0">Dear LEGO</g><g id="1"><x id="2"/>®</g><x id="3"/><g id="4"> colleague,</g><x id="5"/><x id="6"/>Welcome to our Mid-Year Pulse Snapshot Survey.<x id="7"/><x id="8"/>Research consistently shows a strong link between employee engagement and company performance - and we see this clearly at the LEGO Group, where strong business results go hand in hand with record high levels of motivation and satisfaction.</mrk> <mrk mtype="seg" mid="2">Our quarterly and annual People Pulse surveys are an important way to listen to you, helping us collectively understand your experiences and take meaningful actions that enhance motivation, satisfaction, and pride in our workplaces.</mrk> <mrk mtype="seg" mid="3"><x id="9"/><x id="10"/>Our Mid-Year Pulse is especially valuable, providing timely data to identify and address any emerging opportunities and track our progress.<x id="11"/><x id="12"/></mrk> <mrk mtype="seg" mid="4">Please take 5-10 minutes to let us know what we are doing well and where there are opportunities to do even better to enable you and the wider organisation to achieve our mission.</mrk> <mrk mtype="seg" mid="5">This is a great opportunity for you to share your thoughts and provide us with your valuable feedback.<x id="13"/><x id="14"/>Thank you in advance for your participation and for helping us on our journey to make the LEGO Group a unique and world-class workplace.<x id="15"/><x id="16"/><x id="17"/>Daan</mrk></seg-source><target><mrk mtype="seg" mid="1"><g id="0">Thân gửi đồng nghiệp tại LEGO</g><g id="1"><x id="2"/>®</g><x id="3"/><g id="4">,</g><x id="5"/><x id="6"/>Chào mừng bạn đến với khảo sát Pulse Snapshot Survey Giữa Năm của chúng tôi.<x id="7"/><x id="8"/>Nghiên cứu cho thấy một cách nhất quán mối liên hệ chặt chẽ giữa sự gắn kết của nhân viên và hiệu quả hoạt động của công ty - và chúng ta thấy rõ điều này tại Tập Đoàn LEGO, ở đó kết quả kinh doanh hiệu quả đi kèm với mức động lực và sự hài lòng cao kỷ lục.</mrk> <mrk mtype="seg" mid="2">Khảo sát People Pulse hàng quý và hàng năm của chúng tôi là một cách quan trọng để lắng nghe ý kiến của bạn, giúp chúng tôi cùng hiểu trải nghiệm của bạn và thực hiện các hành động có ý nghĩa giúp nâng cao động lực, sự hài lòng và sự tự hào trong môi trường làm việc của chúng ta.</mrk> <mrk mtype="seg" mid="3"><x id="9"/><x id="10"/>Khảo sát Pulse Giữa Năm của chúng tôi đặc biệt có giá trị, cung cấp dữ liệu kịp thời để xác định và giải quyết bất kỳ cơ hội mới xuất hiện nào và theo dõi tiến độ của mình.<x id="11"/><x id="12"/></mrk> <mrk mtype="seg" mid="4">Vui lòng dành ra 5-10 phút để cho chúng tôi biết chúng tôi đang làm tốt điều gì và những lĩnh vực có cơ hội làm tốt hơn nữa để giúp bạn và tổ chức rộng lớn hơn đạt được sứ mệnh của chúng ta.</mrk> <mrk mtype="seg" mid="5">Đây là cơ hội tuyệt vời để bạn chia sẻ suy nghĩ của mình và cung cấp cho chúng tôi phản hồi có giá trị.<x id="13"/><x id="14"/>Xin cảm ơn sự tham gia của bạn và cảm ơn bạn đã giúp chúng tôi trên hành trình biến Tập Đoàn LEGO thành một nơi làm việc độc đáo và đẳng cấp thế giới.<x id="15"/><x id="16"/><x id="17"/>Daan</mrk></target><sdl:seg-defs><sdl:seg id="1" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:prev-origin origin="interactive" percent="100" text-match="SourceAndTarget"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:prev-origin/><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:21:04</sdl:value><sdl:value key="modified_on">05/05/2026 04:21:05</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">418819183</sdl:value><sdl:value key="SegmentIdentityHash">9xA+RX0tkw9zVbmM/LRdN4tg/eK3yZnfcaSanJAUpYY=</sdl:value></sdl:prev-origin><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:21:04</sdl:value><sdl:value key="modified_on">05/05/2026 04:27:58</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">418819183</sdl:value><sdl:value key="SegmentIdentityHash">9xA+RX0tkw9zVbmM/LRdN4tg/eK3yZnfcaSanJAUpYY=</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-540989327</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:28:03</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:21:04</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-540989327</sdl:value><sdl:value key="SegmentIdentityHash">ZzRSvfCYamqKdPFvwDwe4ezOUYM=</sdl:value></sdl:seg><sdl:seg id="2" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:21:43</sdl:value><sdl:value key="modified_on">05/05/2026 04:21:44</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1683444551</sdl:value><sdl:value key="SegmentIdentityHash">2n2vuclsrCPggppuqrKxO0F6dfcWi+lk3x+2GW4YHMA=</sdl:value></sdl:seg><sdl:seg id="3" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:21:50</sdl:value><sdl:value key="modified_on">05/05/2026 04:22:17</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-538690188</sdl:value><sdl:value key="SegmentIdentityHash">RKt2BlbVHtRMF/hLO36poUYDzar3T+fxfpdPb9wxkGU=</sdl:value></sdl:seg><sdl:seg id="4" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:22:42</sdl:value><sdl:value key="modified_on">05/05/2026 04:22:43</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">341158555</sdl:value><sdl:value key="SegmentIdentityHash">O7m7mTdfWgO4WNI18bOlrw19H2OuTNlcIT2zL8A8UMI=</sdl:value></sdl:seg><sdl:seg id="5" conf="Translated" origin="interactive" percent="100" text-match="SourceAndTarget"><sdl:prev-origin origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:prev-origin/><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:23:10</sdl:value><sdl:value key="modified_on">05/05/2026 04:23:11</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2061432495</sdl:value><sdl:value key="SegmentIdentityHash">oq736fWDZgQ7hLYhqpVgFittWFZ6Q3YNsfsCow2NovA=</sdl:value></sdl:prev-origin><sdl:value key="created_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="created_on">05/05/2026 06:43:33</sdl:value><sdl:value key="modified_on">05/05/2026 06:43:33</sdl:value><sdl:value key="last_modified_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1174994913</sdl:value><sdl:value key="SegmentIdentityHash">oq736fWDZgQ7hLYhqpVgFittWFZ6Q3YNsfsCow2NovA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="aab79353-df72-411d-bea5-67dd6040541c"><source><g id="18">How to fill in the questionnaire</g><g id="19"><x id="20"/>Please be aware of the following points when you fill in the People Pulse snapshot survey:<x id="21"/><x id="22"/><x id="23"/>It is your opinion that matters!</g><g id="24">The LEGO Group is interested in your opinion. It is important to answer the questions based on your own personal experiences and impressions that you have had as an employee in the LEGO Group. Therefore, please do not answer the questions based on what you think is the general opinion in the company, or what it could be.<x id="25"/><x id="26"/><x id="27"/>You answer the questions by giving ratings on a scale from one (1) to ten (10)</g><g id="28">Number 1 corresponds to the lowest score and number 10 to the highest. Please indicate your rating by clicking the appropriate box. Answer all of the questions; 1, 2, 3, etc., and if you don&apos;t have a definite opinion, you click the &apos;Don&apos;t know&apos; box.<x id="29"/><x id="30"/>Please note that the texts defining the scale will change depending on the type of questions, so please read them carefully before you answer.<x id="31"/><x id="32"/><x id="33"/>Remember to press “OK” at the end of the survey to submit your responses</g><x id="34"/><x id="35"/>I would also like to remind you that at Ennova we ensure your confidentiality and compliance with international standards in all steps of the process when conducting the data collection, analysis and result distribution.<x id="36"/> <x id="37"/>Thank you for your help.<x id="38"/><x id="39"/><x id="40"/>Kind regards,<x id="41"/><x id="42"/><x id="43"/>Thomas Vestergaard, CEO<x id="44"/><x id="45"/>Ennova A/S<x id="46"/><x id="47"/><x id="48"/></source><seg-source><mrk mtype="seg" mid="6"><g id="18">How to fill in the questionnaire</g><g id="19"><x id="20"/>Please be aware of the following points when you fill in the People Pulse snapshot survey:<x id="21"/><x id="22"/><x id="23"/>It is your opinion that matters!</g><g id="24">The LEGO Group is interested in your opinion. It is important to answer the questions based on your own personal experiences and impressions that you have had as an employee in the LEGO Group. Therefore, please do not answer the questions based on what you think is the general opinion in the company, or what it could be.<x id="25"/><x id="26"/><x id="27"/>You answer the questions by giving ratings on a scale from one (1) to ten (10)</g><g id="28">Number 1 corresponds to the lowest score and number 10 to the highest. Please indicate your rating by clicking the appropriate box. Answer all of the questions; 1, 2, 3, etc., and if you don&apos;t have a definite opinion, you click the &apos;Don&apos;t know&apos; box.<x id="29"/><x id="30"/>Please note that the texts defining the scale will change depending on the type of questions, so please read them carefully before you answer.<x id="31"/><x id="32"/><x id="33"/>Remember to press “OK” at the end of the survey to submit your responses</g><x id="34"/><x id="35"/>I would also like to remind you that at Ennova we ensure your confidentiality and compliance with international standards in all steps of the process when conducting the data collection, analysis and result distribution.<x id="36"/> <x id="37"/>Thank you for your help.<x id="38"/><x id="39"/><x id="40"/>Kind regards,<x id="41"/><x id="42"/><x id="43"/>Thomas Vestergaard, CEO<x id="44"/><x id="45"/>Ennova A/S<x id="46"/><x id="47"/><x id="48"/></mrk></seg-source><target><mrk mtype="seg" mid="6"><g id="18">Cách điền vào bảng câu hỏi</g><g id="19"><x id="20"/>Vui lòng lưu ý những điểm sau đây khi bạn điền vào Khảo Sát Nhanh People Pulse:<x id="20"/><x id="20"/><x id="23"/>Ý kiến của bạn là quan trọng!</g><g id="19">Tập Đoàn LEGO muốn biết ý kiến của bạn. Điều quan trọng là phải trả lời các câu hỏi dựa trên trải nghiệm cá nhân và ấn tượng của riêng bạn mà bạn đã có với tư cách là nhân viên trong Tập Đoàn LEGO. Do đó, vui lòng không trả lời các câu hỏi dựa trên những gì bạn nghĩ là quan điểm chung trong công ty, hoặc quan điểm đó có thể là gì.<x id="20"/><x id="20"/><x id="23"/>Bạn trả lời các câu hỏi bằng cách đưa ra xếp hạng theo thang điểm từ một (1) đến mười (10)</g><g id="19">Số 1 tương ứng với điểm thấp nhất và số 10 là cao nhất. Vui lòng cho biết xếp hạng của bạn bằng cách nhấp vào ô thích hợp. Trả lời tất cả các câu hỏi; 1, 2, 3, v.v., và nếu bạn không có ý kiến xác định, bạn nhấp vào ô Không biết.<x id="20"/><x id="20"/>Vui lòng lưu ý rằng văn bản định nghĩa thang điểm sẽ thay đổi tùy vào loại câu hỏi, do đó vui lòng đọc kỹ trước khi trả lời.<x id="20"/><x id="20"/><x id="23"/>Hãy nhớ nhấn &quot;OK&quot; ở cuối khảo sát để gửi các câu trả lời của bạn</g><x id="20"/><x id="20"/> Tôi cũng muốn nhắc bạn rằng tại Ennova, chúng tôi đảm bảo bảo mật thông tin của bạn và tuân thủ các tiêu chuẩn quốc tế trong tất cả các bước của quy trình khi tiến hành thu thập, phân tích dữ liệu và phổ biến kết quả.<x id="36"/> <x id="20"/>Cảm ơn sự giúp đỡ của bạn.<x id="38"/><x id="20"/><x id="20"/>Trân Trọng<x id="38"/><x id="20"/><x id="20"/>Thomas Vestergaard, CEO<x id="38"/><x id="20"/>Ennova A/S<x id="20"/><x id="20"/><x id="20"/></mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="ApprovedTranslation"><sdl:value key="SegmentIdentityHash">NkzBZb1SAbYgEJkDyekZswcceq+UIzv5vmnPXM97Yuo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:node id="2"/></sdl:cxts><trans-unit id="08fa9344-7d5a-433b-8237-e42aa8984257"><source><g id="80">Completing the questionnaire</g><g id="81"><x id="82"/>The survey is divided into two sections and should take approximately 10 minutes to complete and the deadline for final submissions is <x id="83"/>June 11th</g>.<g id="84"><x id="85"/>Your participation is voluntary.</g><g id="84"> </g><g id="84">Should you find it necessary to take a break before finishing, you can always access the form again to complete it later.</g><g id="84"> </g><g id="84">Answers already provided will be saved automatically.</g><g id="84"> </g><g id="84">Once you have completed your response, you will no longer be able to go back and change them.<x id="86"/><x id="87"/><x id="88"/>If you have any questions or problems</g><g id="89">If you have questions regarding the survey, please contact BSO Service Desk via <x id="90"/>Service Portal Contact Page</g>. If you experience problems with the questionnaire, you are welcome to contact Ennova by e-mail LEGOGroup@ennova.com.<g id="91"><x id="92"/><x id="93"/>Processing personal data and your confidentiality</g><g id="94">Mid-Year People Pulse is carried out by our external survey provider (acting as a data processor) on behalf of your employer, the LEGO Group (acting as the data controller).<x id="95"/><x id="96"/>The LEGO Group has a legitimate interest in processing and collecting your personal data in Mid-Year People Pulse to understand and measure levels of satisfaction, motivation and opinions of employees.<x id="97"/><x id="98"/>To administer the Mid-Year People Pulse and enable aggregated analysis, the LEGO Group will process certain personal data relating to you.</g><g id="94"> </g><g id="94">This will include selected employment related data, such as LEGO e-mail address, ELT area, department name, team name, work location, seniority with the LEGO Group, salaried/non-salaried status, company code, job level or similar information but also full name, age and gender.<x id="99"/><x id="100"/>It is also important to inform you that only the necessary personal data will be processed for Mid-Year People Pulse to achieve the above-mentioned purposes.<x id="101"/><x id="102"/>By proceeding, you start the questionnaire where the LEGO Group will process your personal data in connection with Mid-Year People Pulse snapshot survey.</g><g id="94"> </g><g id="94">For employees within the EU the legal basis is legitimate interest cf. GDPR, art.</g><g id="94"> </g><g id="94">6, 1(f).<x id="103"/><x id="104"/>You can read more about the LEGO Group&apos;s processing of your personal data here:<x id="105"/><x id="106"/><x id="107"/><x id="108"/>Global Employee Privacy Policy.docx</g><x id="109"/><x id="110"/><x id="111"/>Results from first section of the survey are only made available with a minimum of five responses. If you are in a team with less than five respondents, your answers will be included in a joint result.<x id="112"/><x id="113"/>Your individual identifiable responses to second section of the survey will be available to the LEGO Group, however access is strictly limited to a small number of employees within the People Insights &amp; Analytics team (a team of no more than 5 employees) in the LEGO Group who need this access for analysis purposes. Your individual identifiable responses will not be shared with People Leaders, People Partners, functional leaders or anyone else apart from the People Insights &amp; Analytics team. Your People Leaders, People Partners, functional leaders will only receive aggregated results with a minimum of five responses. If you are in a team with less than five respondents, your answers will be included in a joint result.<x id="114"/><x id="115"/>All responses are handled confidentially by the LEGO Group and are subject to appropriate technical and organisational measures to protect your personal data. Your individual responses will be transferred to Qualtrics for analytics as described above.<x id="116"/><x id="117"/>If you want access to your data, want to have your data deleted or want to exercise another Privacy Right in the GDPR, you need to use the link above to make sure that your request will be well received and handled by the LEGO Group.<x id="118"/><x id="119"/>If you may have questions about how the LEGO Group is handling your personal data, you can ask the Data Protection Officer (DPO) - gdpr.hr@LEGO.com.</source><seg-source><mrk mtype="seg" mid="7"><g id="80">Completing the questionnaire</g><g id="81"><x id="82"/>The survey is divided into two sections and should take approximately 10 minutes to complete and the deadline for final submissions is <x id="83"/>June 11th</g>.<g id="84"><x id="85"/>Your participation is voluntary.</g></mrk><g id="84"> </g><mrk mtype="seg" mid="8"><g id="84">Should you find it necessary to take a break before finishing, you can always access the form again to complete it later.</g></mrk><g id="84"> </g><mrk mtype="seg" mid="9"><g id="84">Answers already provided will be saved automatically.</g></mrk><g id="84"> </g><mrk mtype="seg" mid="10"><g id="84">Once you have completed your response, you will no longer be able to go back and change them.<x id="86"/><x id="87"/><x id="88"/>If you have any questions or problems</g><g id="89">If you have questions regarding the survey, please contact BSO Service Desk via <x id="90"/>Service Portal Contact Page</g>.</mrk> <mrk mtype="seg" mid="11">If you experience problems with the questionnaire, you are welcome to contact Ennova by e-mail LEGOGroup@ennova.com.<g id="91"><x id="92"/><x id="93"/>Processing personal data and your confidentiality</g><g id="94">Mid-Year People Pulse is carried out by our external survey provider (acting as a data processor) on behalf of your employer, the LEGO Group (acting as the data controller).<x id="95"/><x id="96"/>The LEGO Group has a legitimate interest in processing and collecting your personal data in Mid-Year People Pulse to understand and measure levels of satisfaction, motivation and opinions of employees.<x id="97"/><x id="98"/>To administer the Mid-Year People Pulse and enable aggregated analysis, the LEGO Group will process certain personal data relating to you.</g></mrk><g id="94"> </g><mrk mtype="seg" mid="12"><g id="94">This will include selected employment related data, such as LEGO e-mail address, ELT area, department name, team name, work location, seniority with the LEGO Group, salaried/non-salaried status, company code, job level or similar information but also full name, age and gender.<x id="99"/><x id="100"/>It is also important to inform you that only the necessary personal data will be processed for Mid-Year People Pulse to achieve the above-mentioned purposes.<x id="101"/><x id="102"/>By proceeding, you start the questionnaire where the LEGO Group will process your personal data in connection with Mid-Year People Pulse snapshot survey.</g></mrk><g id="94"> </g><mrk mtype="seg" mid="13"><g id="94">For employees within the EU the legal basis is legitimate interest cf. GDPR, art.</g></mrk><g id="94"> </g><mrk mtype="seg" mid="14"><g id="94">6, 1(f).<x id="103"/><x id="104"/>You can read more about the LEGO Group&apos;s processing of your personal data here:<x id="105"/><x id="106"/><x id="107"/><x id="108"/>Global Employee Privacy Policy.docx</g><x id="109"/><x id="110"/><x id="111"/>Results from first section of the survey are only made available with a minimum of five responses.</mrk> <mrk mtype="seg" mid="15">If you are in a team with less than five respondents, your answers will be included in a joint result.<x id="112"/><x id="113"/>Your individual identifiable responses to second section of the survey will be available to the LEGO Group, however access is strictly limited to a small number of employees within the People Insights &amp; Analytics team (a team of no more than 5 employees) in the LEGO Group who need this access for analysis purposes.</mrk> <mrk mtype="seg" mid="16">Your individual identifiable responses will not be shared with People Leaders, People Partners, functional leaders or anyone else apart from the People Insights &amp; Analytics team.</mrk> <mrk mtype="seg" mid="17">Your People Leaders, People Partners, functional leaders will only receive aggregated results with a minimum of five responses.</mrk> <mrk mtype="seg" mid="18">If you are in a team with less than five respondents, your answers will be included in a joint result.<x id="114"/><x id="115"/>All responses are handled confidentially by the LEGO Group and are subject to appropriate technical and organisational measures to protect your personal data.</mrk> <mrk mtype="seg" mid="19">Your individual responses will be transferred to Qualtrics for analytics as described above.<x id="116"/><x id="117"/>If you want access to your data, want to have your data deleted or want to exercise another Privacy Right in the GDPR, you need to use the link above to make sure that your request will be well received and handled by the LEGO Group.<x id="118"/><x id="119"/>If you may have questions about how the LEGO Group is handling your personal data, you can ask the Data Protection Officer (DPO) - gdpr.hr@LEGO.com.</mrk></seg-source><target><mrk mtype="seg" mid="7"><g id="80">Hoàn thành bảng câu hỏi</g><g id="81"><x id="82"/>Khảo sát được chia thành hai phần và sẽ mất khoảng 10 phút để hoàn thành và thời hạn nộp cuối cùng là <x id="83"/>ngày 11 tháng 6</g>.<g id="84"><x id="85"/>Sự tham gia của bạn là tự nguyện.</g></mrk><g id="84"> </g><mrk mtype="seg" mid="8"><g id="84">Nếu bạn thấy cần phải giải lao trước khi hoàn thành, bạn luôn có thể truy cập lại mẫu đơn này để hoàn thành sau.</g></mrk><g id="84"> </g><mrk mtype="seg" mid="9"><g id="84">Các câu trả lời đã được cung cấp sẽ được tự động lưu.</g></mrk><g id="84"> </g><mrk mtype="seg" mid="10"><g id="84">Sau khi hoàn tất câu trả lời, bạn sẽ không thể trở lại và thay đổi.<x id="86"/><x id="87"/><x id="88"/>Nếu bạn có bất kỳ thắc mắc hoặc vấn đề nào</g><g id="89">Nếu bạn có thắc mắc về khảo sát, vui lòng liên hệ với Bộ Phận Hỗ Trợ Dịch Vụ BSO thông qua <x id="90"/>Trang LIÊN HỆ CỔNG THÔNG TIN DỊCH VỤ</g>.</mrk> <mrk mtype="seg" mid="11">Nếu bạn gặp vấn đề với bảng câu hỏi, bạn có thể liên hệ với Ennova qua email LEGOGroup@ennova.com.<g id="91"><x id="92"/><x id="93"/>Xử lý dữ liệu cá nhân và bảo mật thông tin của bạn</g><g id="94">Khảo sát People Pulse Giữa Năm được thực hiện bởi nhà cung cấp dịch vụ khảo sát bên ngoài của chúng tôi (đóng vai trò là đơn vị xử lý dữ liệu) thay mặt cho nhà tuyển dụng của bạn, Tập Đoàn LEGO (đóng vai trò là đơn vị kiểm soát dữ liệu).<x id="95"/><x id="96"/>Tập Đoàn LEGO có lợi ích chính đáng trong việc xử lý và thu thập dữ liệu cá nhân của bạn trong khảo sát People Pulse Giữa Năm để hiểu và đánh giá mức độ hài lòng, động lực và ý kiến của nhân viên.<x id="97"/><x id="98"/>Để quản lý khảo sát People Pulse Giữa Năm và tạo điều kiện phân tích tổng hợp, Tập Đoàn LEGO sẽ xử lý dữ liệu cá nhân nhất định liên quan đến bạn.</g></mrk><g id="94"> </g><mrk mtype="seg" mid="12"><g id="94">Thông tin này sẽ bao gồm dữ liệu chọn lọc liên quan đến công việc, chẳng hạn như địa chỉ email LEGO, khu vực ELT, tên phòng ban, tên đội ngũ, địa điểm làm việc, thâm niên với Tập Đoàn LEGO, tình trạng hưởng lương/không lương, mã công ty, cấp công việc hoặc thông tin tương tự nhưng cũng bao gồm họ tên, tuổi và giới tính.<x id="99"/><x id="100"/>Cũng cần thông tin cho bạn rằng chỉ có dữ liệu cá nhân cần thiết mới được xử lý cho khảo sát People Pulse Giữa Năm để đạt được các mục đích đã đề cập bên trên.<x id="101"/><x id="102"/>Bằng việc tiếp tục, bạn sẽ bắt đầu trả lời bảng câu hỏi, trong đó Tập Đoàn LEGO sẽ xử lý dữ liệu cá nhân của bạn liên quan đến khảo sát People Pulse snapshot Giữa Năm.</g></mrk><g id="94"> </g><mrk mtype="seg" mid="13"><g id="94">Đối với nhân viên trong EU, cơ sở pháp lý là lợi ích hợp pháp, xem thêm GDPR, điều</g></mrk><g id="94"> </g><mrk mtype="seg" mid="14"><g id="94">6, 1(f).<x id="103"/><x id="104"/>Bạn có thể đọc thêm về việc Tập Đoàn LEGO xử lý dữ liệu cá nhân của bạn ở đây:<x id="105"/><x id="106"/><x id="107"/><x id="108"/>Global Employee Privacy Policy.docx</g><x id="109"/><x id="110"/><x id="111"/>Kết quả từ phần đầu tiên của khảo sát chỉ được cung cấp với tối thiểu 5 câu trả lời.</mrk> <mrk mtype="seg" mid="15">Nếu bạn thuộc một nhóm có ít hơn 5 người trả lời, câu trả lời của bạn sẽ được đưa vào kết quả chung.<x id="112"/><x id="113"/>Các câu trả lời có thể nhận dạng cá nhân của bạn cho phần thứ hai của khảo sát sẽ được cung cấp cho Tập Đoàn LEGO, tuy nhiên quyền tiếp cận chỉ giới hạn ở một số ít nhân viên trong đội ngũ People Insights &amp; Analytics (một nhóm không quá 5 nhân viên) trong Tập Đoàn LEGO, họ cần quyền tiếp cận này cho mục đích phân tích.</mrk> <mrk mtype="seg" mid="16">Các câu trả lời có thể nhận dạng cá nhân của bạn sẽ không được chia sẻ với các Nhà Lãnh Đạo Nhân Sự, Đối Tác Nhân Sự, lãnh đạo bộ phận hoặc bất kỳ ai bên ngoài đội ngũ People Insights &amp; Analytics.</mrk> <mrk mtype="seg" mid="17">Các Nhà Lãnh Đạo Nhân Sự, Đối Tác Nhân Sự, các lãnh đạo bộ phận sẽ chỉ nhận được kết quả tổng hợp với tối thiểu 5 câu trả lời.</mrk> <mrk mtype="seg" mid="18">Nếu bạn thuộc một nhóm có ít hơn 5 người trả lời, câu trả lời của bạn sẽ được đưa vào kết quả chung.<x id="114"/><x id="115"/>Tất cả các câu trả lời được xử lý bảo mật bởi Tập Đoàn LEGO và phải tuân theo các biện pháp kỹ thuật và tổ chức thích hợp để bảo vệ dữ liệu cá nhân của bạn.</mrk> <mrk mtype="seg" mid="19">Các câu trả lời cá nhân của bạn sẽ được chuyển cho Qualtrics để phân tích như mô tả bên trên.<x id="116"/><x id="117"/>Nếu bạn muốn tiếp cận dữ liệu của mình, muốn xóa dữ liệu hoặc muốn thực hiện một Quyền Riêng Tư khác theo GDPR, bạn cần phải sử dụng liên kết bên trên để đảm bảo rằng yêu cầu của bạn sẽ được Tập Đoàn LEGO tiếp nhận và xử lý tốt.<x id="118"/><x id="119"/>Nếu bạn có thắc mắc về cách Tập Đoàn LEGO xử lý dữ liệu cá nhân của mình, bạn có thể hỏi Cán Bộ Bảo Vệ Dữ Liệu (DPO) - gdpr.hr@LEGO.com.</mrk></target><sdl:seg-defs><sdl:seg id="7" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:23:32</sdl:value><sdl:value key="modified_on">05/05/2026 04:23:33</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1712691596</sdl:value><sdl:value key="SegmentIdentityHash">fLG6YZN9yrJvAO9C8FFvnPvMfbxPOr2tKcLKt8pRqPQ=</sdl:value></sdl:seg><sdl:seg id="8" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:23:38</sdl:value><sdl:value key="modified_on">05/05/2026 04:23:38</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1620365912</sdl:value><sdl:value key="SegmentIdentityHash">ihsAnBeQvpa7CeXhkjPUvx960xgg7MRxkkqejzOeO4o=</sdl:value></sdl:seg><sdl:seg id="9" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:23:46</sdl:value><sdl:value key="modified_on">05/05/2026 04:23:57</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="SDL:OriginalTranslationHash">775422926</sdl:value><sdl:value key="SegmentIdentityHash">wK/TIbFMqY4TJPFFOrby4R8aMy5E1OJhMIFqYDbIb54=</sdl:value></sdl:seg><sdl:seg id="10" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="modified_on">05/05/2026 06:43:50</sdl:value><sdl:value key="created_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="created_on">05/05/2026 06:43:50</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-78637558</sdl:value><sdl:value key="SegmentIdentityHash">m9ajDZmyYptez73kgQ2rWoKb7Rs=</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1520997050</sdl:value></sdl:seg><sdl:seg id="11" conf="Translated" origin="interactive"><sdl:value key="last_modified_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="modified_on">05/05/2026 06:47:07</sdl:value><sdl:value key="created_by">DESKTOP-HG1M5KF\Window</sdl:value><sdl:value key="created_on">05/05/2026 06:44:01</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1327678078</sdl:value><sdl:value key="SegmentIdentityHash">HTEVg9f9CYvqCVR9gtpdVobm6+o=</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-297870974</sdl:value></sdl:seg><sdl:seg id="12" conf="Translated" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin origin="nmt" origin-system="Machine Translation"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">qgF1VB75KXaK1QJeBqlfwyga8nK1VSOUAqHulGsf0a8=</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">qgF1VB75KXaK1QJeBqlfwyga8nK1VSOUAqHulGsf0a8=</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:30:37</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">qgF1VB75KXaK1QJeBqlfwyga8nK1VSOUAqHulGsf0a8=</sdl:value><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:31:14</sdl:value><sdl:value key="created_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="created_on">05/05/2026 04:30:41</sdl:value><sdl:value key="SDL:ProjectTranslationHash">435118042</sdl:value></sdl:seg><sdl:seg id="13" conf="Translated" origin="tm" origin-system="2k UK_UK - VI TM" percent="100"><sdl:prev-origin><sdl:value key="SegmentIdentityHash">OajcWB8k76Q1hHQ+34CMV9mLGgxzZ/hRyhWe+sNZVgg=</sdl:value></sdl:prev-origin><sdl:value key="last_modified_by">NTNVIRTUALWIN11\Tuan Ngoc Ngo</sdl:value><sdl:value key="modified_on">05/05/2026 04:31:18</sdl:value><sdl:value 